\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Post-training flat-sky $D_\ell $ comparison for the trained $p(f)$ prior in $\mu \mathrm  {K}_{\rm  CMB}$-based map units (after de-standardisation), shown here on the legacy four-panel layout produced by an earlier $(T,Q,U)$-channel run of the notebook for visual context. The current notebook is restricted to temperature, and the relevant panel is the top-left $D_\ell ^{TT}$. Solid black: validation patches drawn from the saved $p(f)$ prior, the empirical reference distribution. Dashed coloured: patches generated by the trained deterministic flow-matching model, sampled with the Heun second-order ODE integrator at $N_{\rm  steps}=1200$, $t\in [0,0.995]$, and a state-clipping bound $|\xvec  |\!\leq \!5$. Dotted grey: Monte Carlo theory band built from independent Gaussian full-sky realisations of the lensed CAMB spectra passed through the identical patch and flat-sky pipeline. The agreement between the validation and theory bands is a calibration check on the patch / flat-sky estimator pipeline itself; the agreement between the generated and validation bands is the direct test of the trained prior.}}{50}{figure.1}\protected@file@percent }
\newlabel{fig:dl_panel_phys}{{1}{50}{Post-training flat-sky $D_\ell $ comparison for the trained $p(f)$ prior in $\mu \mathrm {K}_{\rm CMB}$-based map units (after de-standardisation), shown here on the legacy four-panel layout produced by an earlier $(T,Q,U)$-channel run of the notebook for visual context. The current notebook is restricted to temperature, and the relevant panel is the top-left $D_\ell ^{TT}$. Solid black: validation patches drawn from the saved $p(f)$ prior, the empirical reference distribution. Dashed coloured: patches generated by the trained deterministic flow-matching model, sampled with the Heun second-order ODE integrator at $N_{\rm steps}=1200$, $t\in [0,0.995]$, and a state-clipping bound $|\xvec |\!\leq \!5$. Dotted grey: Monte Carlo theory band built from independent Gaussian full-sky realisations of the lensed CAMB spectra passed through the identical patch and flat-sky pipeline. The agreement between the validation and theory bands is a calibration check on the patch / flat-sky estimator pipeline itself; the agreement between the generated and validation bands is the direct test of the trained prior}{figure.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Same as Fig.~\ref {fig:dl_panel_phys} but in normalised patch units, i.e.\ before applying the inverse standardisation of Sec.~\ref {sec:data_savedpriors}. This is the domain in which the network is trained.}}{51}{figure.2}\protected@file@percent }
\newlabel{fig:dl_panel_norm}{{2}{51}{Same as Fig.~\ref {fig:dl_panel_phys} but in normalised patch units, i.e.\ before applying the inverse standardisation of Sec.~\ref {sec:data_savedpriors}. This is the domain in which the network is trained}{figure.2}{}}
\gdef \@abspage@last{51}
