    "def flat_sky_tt_power_spectrum(T_patches: np.ndarray, reso_arcmin: float = 6.7):\n",
    "    \"\"\"\n",
    "    Compute the azimuthally-averaged TT power spectrum from flat-sky patches.\n",
    "\n",
    "    Args:\n",
    "        T_patches: (N, H, W) array of temperature patches (physical units or normalized).\n",
    "        reso_arcmin: pixel resolution in arcminutes.\n",
    "    Returns:\n",
    "        ells: 1-D array of multipole bin centres.\n",
    "        cl_tt: 1-D array of C_ell^TT averaged over patches.\n",
    "    \"\"\"\n",
    "    N, H, W = T_patches.shape\n",
    "    reso_rad = np.deg2rad(reso_arcmin / 60.0)\n",
    "\n",
    "    kx = np.fft.fftfreq(W, d=reso_rad)\n",
    "    ky = np.fft.fftfreq(H, d=reso_rad)\n",
    "    KX, KY = np.meshgrid(kx, ky)\n",
    "    K_mag = np.sqrt(KX**2 + KY**2)\n",
    "    ell_map = 2 * np.pi * K_mag\n",
    "\n",
    "    ell_max = ell_map.max()\n",
    "    num_bins = min(H // 2, 30)\n",
    "    bin_edges = np.linspace(0, ell_max, num_bins + 1)\n",
    "    ell_centres = 0.5 * (bin_edges[:-1] + bin_edges[1:])\n",
    "\n",
    "    cl_sum = np.zeros(num_bins)\n",
    "    counts = np.zeros(num_bins)\n",
    "\n",
    "    for i in range(N):\n",
    "        fft2 = np.fft.fft2(T_patches[i])\n",
    "        power = np.abs(fft2) ** 2 * reso_rad**2 / (H * W)\n",
    "        for b in range(num_bins):\n",
    "            mask = (ell_map >= bin_edges[b]) & (ell_map < bin_edges[b + 1])\n",
    "            if mask.any():\n",
    "                cl_sum[b] += power[mask].mean()\n",
    "                counts[b] += 1\n",
    "\n",
    "    valid = counts > 0\n",
    "    cl_tt = np.full(num_bins, np.nan)\n",
    "    cl_tt[valid] = cl_sum[valid] / counts[valid]\n",
    "\n",
    "    return ell_centres, cl_tt\n",
    "\n",
    "\n",
    "def flat_sky_full_spectra(patches_tqu: np.ndarray, reso_arcmin: float = 6.7):\n",
    "    \"\"\"\n",
    "    Compute TT, EE, BB, TE power spectra from flat-sky (T,Q,U) patches.\n",
    "\n",
    "    Args:\n",
    "        patches_tqu: (N, 3, H, W) array of (T, Q, U) patches.\n",
    "        reso_arcmin: pixel resolution in arcminutes.\n",
    "    Returns:\n",
    "        ells: 1-D array of multipole bin centres.\n",
    "        spectra: dict with keys 'TT', 'EE', 'BB', 'TE', each a 1-D array.\n",
    "    \"\"\"\n",
    "    N, _, H, W = patches_tqu.shape\n",
    "    reso_rad = np.deg2rad(reso_arcmin / 60.0)\n",
    "\n",
    "    kx = np.fft.fftfreq(W, d=reso_rad)\n",
    "    ky = np.fft.fftfreq(H, d=reso_rad)\n",
    "    KX, KY = np.meshgrid(kx, ky)\n",
    "    K_mag = np.sqrt(KX**2 + KY**2)\n",
    "    ell_map = 2 * np.pi * K_mag\n",
    "    phi_k = np.arctan2(KY, KX)\n",
    "    cos2phi = np.cos(2 * phi_k)\n",
    "    sin2phi = np.sin(2 * phi_k)\n",
    "\n",
    "    ell_max = ell_map.max()\n",
    "    num_bins = min(H // 2, 30)\n",
    "    bin_edges = np.linspace(0, ell_max, num_bins + 1)\n",
    "    ell_centres = 0.5 * (bin_edges[:-1] + bin_edges[1:])\n",
    "\n",
    "    norm = reso_rad**2 / (H * W)\n",
    "    accum = {k: np.zeros(num_bins) for k in ['TT', 'EE', 'BB', 'TE']}\n",
    "    counts = np.zeros(num_bins)\n",
    "\n",
    "    for i in range(N):\n",
    "        T_fft = np.fft.fft2(patches_tqu[i, 0])\n",
    "        Q_fft = np.fft.fft2(patches_tqu[i, 1])\n",
    "        U_fft = np.fft.fft2(patches_tqu[i, 2])\n",
    "\n",
    "        # E/B decomposition: E_k = -Q_k cos(2phi) - U_k sin(2phi)\n",
    "        #                     B_k =  Q_k sin(2phi) - U_k cos(2phi)\n",
    "        E_fft = -Q_fft * cos2phi - U_fft * sin2phi\n",
    "        B_fft =  Q_fft * sin2phi - U_fft * cos2phi\n",
    "\n",
    "        P_TT = np.abs(T_fft)**2 * norm\n",
    "        P_EE = np.abs(E_fft)**2 * norm\n",
    "        P_BB = np.abs(B_fft)**2 * norm\n",
    "        P_TE = np.real(T_fft * np.conj(E_fft)) * norm\n",
    "\n",
    "        for b in range(num_bins):\n",
    "            mask = (ell_map >= bin_edges[b]) & (ell_map < bin_edges[b + 1])\n",
    "            if mask.any():\n",
    "                accum['TT'][b] += P_TT[mask].mean()\n",
    "                accum['EE'][b] += P_EE[mask].mean()\n",
    "                accum['BB'][b] += P_BB[mask].mean()\n",
    "                accum['TE'][b] += P_TE[mask].mean()\n",
    "                if i == 0:\n",
    "                    counts[b] += 1\n",
    "\n",
    "    valid = counts > 0\n",
    "    spectra = {}\n",
    "    for k in ['TT', 'EE', 'BB', 'TE']:\n",
    "        arr = np.full(num_bins, np.nan)\n",
    "        arr[valid] = accum[k][valid] / N\n",
    "        spectra[k] = arr\n",
    "\n",
    "    return ell_centres, spectra\n",
    "\n",
    "\n",
    "def flat_sky_full_spectra_binned(patches_tqu: np.ndarray,\n",
    "                                 reso_arcmin: float = 6.7,\n",
    "                                 num_bins: int = 48,\n",
    "                                 binning: str = 'log'):\n",
    "    \"\"\"\n",
    "    Compute TT, EE, BB, TE flat-sky spectra with configurable radial binning.\n",
    "\n",
    "    This is intended for presentation-style patch spectra. In particular,\n",
    "    log-spaced annuli with more bins give a smoother P(k)-style curve that is\n",
    "    visually closer to patch-spectrum plots shown in ML papers, while the\n",
    "    legacy flat_sky_full_spectra() above is kept unchanged for backward\n",
    "    compatibility with earlier notebook diagnostics.\n",
    "\n",
    "    Args:\n",
    "        patches_tqu: (N, 3, H, W) array of (T, Q, U) patches.\n",
    "        reso_arcmin: pixel resolution in arcminutes.\n",
    "        num_bins: number of annular bins in |k| or ell.\n",
    "        binning: 'log' or 'linear'.\n",
    "    Returns:\n",
    "        ell_centres: 1-D array of valid multipole bin centres.\n",
    "        spectra: dict with keys 'TT', 'EE', 'BB', 'TE', each a 1-D array.\n",
    "    \"\"\"\n",
    "    N, _, H, W = patches_tqu.shape\n",
    "    reso_rad = np.deg2rad(reso_arcmin / 60.0)\n",
    "\n",
    "    kx = np.fft.fftfreq(W, d=reso_rad)\n",
    "    ky = np.fft.fftfreq(H, d=reso_rad)\n",
    "    KX, KY = np.meshgrid(kx, ky)\n",
    "    K_mag = np.sqrt(KX**2 + KY**2)\n",
    "    ell_map = 2 * np.pi * K_mag\n",
    "    phi_k = np.arctan2(KY, KX)\n",
    "    cos2phi = np.cos(2 * phi_k)\n",
    "    sin2phi = np.sin(2 * phi_k)\n",
    "\n",
    "    positive_ells = ell_map[ell_map > 0]\n",
    "    if positive_ells.size == 0:\n",
    "        raise ValueError('No positive Fourier modes available for flat-sky binning.')\n",
    "    ell_min = float(np.min(positive_ells))\n",
    "    ell_max = float(np.max(positive_ells))\n",
    "    num_bins = max(4, int(num_bins))\n",
    "    if binning == 'log':\n",
    "        bin_edges = np.geomspace(ell_min, ell_max, num_bins + 1)\n",
    "        ell_centres = np.sqrt(bin_edges[:-1] * bin_edges[1:])\n",
    "    elif binning == 'linear':\n",
    "        bin_edges = np.linspace(0.0, ell_max, num_bins + 1)\n",
    "        ell_centres = 0.5 * (bin_edges[:-1] + bin_edges[1:])\n",
    "    else:\n",
    "        raise ValueError(\"binning must be 'log' or 'linear'.\")\n",
    "\n",
    "    norm = reso_rad**2 / (H * W)\n",
    "    accum = {k: np.zeros(num_bins, dtype=np.float64) for k in ['TT', 'EE', 'BB', 'TE']}\n",
    "    mode_counts = np.zeros(num_bins, dtype=np.int64)\n",
    "    bin_masks = []\n",
    "    for b in range(num_bins):\n",
    "        if b == num_bins - 1:\n",
    "            mask = (ell_map >= bin_edges[b]) & (ell_map <= bin_edges[b + 1])\n",
    "        else:\n",
    "            mask = (ell_map >= bin_edges[b]) & (ell_map < bin_edges[b + 1])\n",
    "        bin_masks.append(mask)\n",
    "        mode_counts[b] = int(mask.sum())\n",
    "\n",
    "    for i in range(N):\n",
    "        T_fft = np.fft.fft2(patches_tqu[i, 0])\n",
    "        Q_fft = np.fft.fft2(patches_tqu[i, 1])\n",
    "        U_fft = np.fft.fft2(patches_tqu[i, 2])\n",
    "        E_fft = -Q_fft * cos2phi - U_fft * sin2phi\n",
    "        B_fft =  Q_fft * sin2phi - U_fft * cos2phi\n",
    "\n",
    "        P_TT = np.abs(T_fft)**2 * norm\n",
    "        P_EE = np.abs(E_fft)**2 * norm\n",
    "        P_BB = np.abs(B_fft)**2 * norm\n",
    "        P_TE = np.real(T_fft * np.conj(E_fft)) * norm\n",
    "\n",
    "        for b, mask in enumerate(bin_masks):\n",
    "            if mode_counts[b] == 0:\n",
    "                continue\n",
    "            accum['TT'][b] += float(P_TT[mask].mean())\n",
    "            accum['EE'][b] += float(P_EE[mask].mean())\n",
    "            accum['BB'][b] += float(P_BB[mask].mean())\n",
    "            accum['TE'][b] += float(P_TE[mask].mean())\n",
    "\n",
    "    valid = mode_counts > 0\n",
    "    ell_centres = ell_centres[valid]\n",
    "    spectra = {k: (accum[k][valid] / max(N, 1)) for k in ['TT', 'EE', 'BB', 'TE']}\n",
    "    return ell_centres, spectra\n",
