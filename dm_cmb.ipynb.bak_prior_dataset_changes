    "def _d4_augment_tqu(x: torch.Tensor) -> torch.Tensor:\n",
    "    \"\"\"Apply a uniformly-random D4 group element to a (B, 3, H, W) TQU batch.\n",
    "\n",
    "    The CMB is statistically isotropic, so any rotation/reflection of a flat\n",
    "    patch is also a valid sample from the same distribution (at the patch\n",
    "    sizes used here, curvature corrections to flat-sky symmetry are\n",
    "    negligible). T transforms as a scalar; (Q, U) carry spin-2, so each\n",
    "    90 deg rotation or reflection is accompanied by an explicit sign\n",
    "    convention on Q and U that keeps the E/B decomposition consistent with\n",
    "    the pixel-space transform.\n",
    "    \"\"\"\n",
    "    if x.ndim != 4 or x.shape[1] != 3:\n",
    "        raise ValueError('Expected (B, 3, H, W) TQU batch.')\n",
    "    k = int(torch.randint(0, 4, (1,)).item())\n",
    "    do_flip = bool(torch.randint(0, 2, (1,)).item())\n",
    "    out = x\n",
    "    if k > 0:\n",
    "        out = torch.rot90(out, k=k, dims=(-2, -1))\n",
    "        if k % 2 == 1:\n",
    "            # 90 / 270 deg pixel rotation -> (Q, U) -> (-Q, -U); T unchanged.\n",
    "            sign = torch.tensor([1.0, -1.0, -1.0], device=out.device, dtype=out.dtype)\n",
    "            out = out * sign.view(1, 3, 1, 1)\n",
    "    if do_flip:\n",
    "        # Reflection across the x-axis (y -> -y): T unchanged, Q unchanged, U -> -U.\n",
    "        out = torch.flip(out, dims=(-2,))\n",
    "        sign = torch.tensor([1.0, 1.0, -1.0], device=out.device, dtype=out.dtype)\n",
    "        out = out * sign.view(1, 3, 1, 1)\n",
    "    return out\n",
