    "class SDE(ABC):\n",
    "    @abstractmethod\n",
    "    def drift_coefficient(self, xt: torch.Tensor, t: torch.Tensor, **kwargs) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Returns the drift coefficient of the ODE.\n",
    "        Args:\n",
    "            - xt: state at time t, shape (bs, c, h, w)\n",
    "            - t: time, shape (bs, 1)\n",
    "        Returns:\n",
    "            - drift_coefficient/vector field u_t(x,t): shape (bs, c, h, w)\n",
    "        \"\"\"\n",
    "        pass\n",
    "\n",
    "    @abstractmethod\n",
    "    def diffusion_coefficient(self, xt: torch.Tensor, t: torch.Tensor, **kwargs) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Returns the diffusion coefficient of the ODE.\n",
    "        Args:\n",
    "            - xt: state at time t, shape (bs, c, h, w)\n",
    "            - t: time, shape (bs, 1, 1, 1)\n",
    "        Returns:\n",
    "            - diffusion_coefficient: shape (bs, c, h, w)\n",
    "        \"\"\"\n",
    "        pass\n",
    "\n",
    "\n",
    "class Simulator(ABC):\n",
    "    @abstractmethod\n",
    "    def step(self, xt: torch.Tensor, t: torch.Tensor, dt: torch.Tensor, **kwargs) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Takes one simulation step\n",
    "        Args:\n",
    "            - xt: state at time t, shape (bs, c, h, w)\n",
    "            - t: time, shape (bs, 1, 1, 1)\n",
    "            - dt: time, shape (bs, 1, 1, 1)\n",
    "        Returns:\n",
    "            - nxt: state at time t + dt (bs, c, h, w)\n",
    "        \"\"\"\n",
    "        pass\n",
    "\n",
    "\n",
    "    \"\"\"\n",
    "    you're running a trained model forward to generate samples, not training it.\n",
    "    During training, you need gradients so PyTorch can backpropagate and update weights. \n",
    "    So training functions must not have @torch.no_grad().\n",
    "    During sampling, gradients are useless, without @torch.no_grad(), PyTorch would still build the \n",
    "    computation graph at every step, wasting memory and time for gradients you'll never use.\n",
    "    \"\"\"\n",
    "    @torch.no_grad()\n",
    "    def simulate(self, x0: torch.Tensor, ts: torch.Tensor, **kwargs) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Simulates using the discretization gives by ts\n",
    "        Args:\n",
    "            - x_init: initial state, shape (bs, c, h, w)\n",
    "            - ts: timesteps, shape (bs, nts, 1, 1, 1)\n",
    "            - state_clip_abs: if set, clamp state to [-v, v] after each step (not passed to SDE).\n",
    "        Returns:\n",
    "            - x_final: final state at time ts[-1], shape (bs, c, h, w)\n",
    "        \"\"\"\n",
    "        kw = dict(kwargs)\n",
    "        clip = kw.pop('state_clip_abs', None)\n",
    "        x = x0\n",
    "        nts = ts.shape[1]\n",
    "        for t_idx in tqdm(range(nts - 1)):\n",
    "            t = ts[:, t_idx, :, :, :]\n",
    "            h = ts[:, t_idx + 1, :, :, :] - ts[:, t_idx, :, :, :]\n",
    "            x = self.step(x, t, h, **kw)\n",
    "            if clip is not None:\n",
    "                x = torch.clamp(x, -float(clip), float(clip))\n",
    "        return x\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def simulate_with_trajectory(self, x0: torch.Tensor, ts: torch.Tensor, **kwargs) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Simulates using the discretization gives by ts\n",
    "        Args:\n",
    "            - x_init: initial state, shape (bs, c, h, w)\n",
    "            - ts: timesteps, shape (bs, nts, 1, 1, 1)\n",
    "            - state_clip_abs: optional clamp after each step (not passed to SDE).\n",
    "        Returns:\n",
    "            - x_final: final state at time ts[-1], shape (bs, c, h, w)\n",
    "        \"\"\"\n",
    "\n",
    "        kw = dict(kwargs)\n",
    "        clip = kw.pop('state_clip_abs', None)\n",
    "        xs = [x0.clone()]\n",
    "        x = x0\n",
    "        nts = ts.shape[1]\n",
    "        for t_idx in tqdm(range(nts - 1)):\n",
    "            t = ts[:, t_idx, :, :, :]\n",
    "            h = ts[:, t_idx + 1, :, :, :] - ts[:, t_idx, :, :, :]\n",
    "            x = self.step(x, t, h, **kw)\n",
    "            if clip is not None:\n",
    "                x = torch.clamp(x, -float(clip), float(clip))\n",
    "            xs.append(x.clone())\n",
    "        return torch.stack(xs, dim=1)\n",
    "\n",
    "\n",
    "\n",
    "class EulerMaruyamaSimulator(Simulator):\n",
    "    def __init__(self, sde: SDE):\n",
    "        self.sde = sde\n",
    "\n",
    "    def step(self, xt: torch.Tensor, t: torch.Tensor, dt: torch.Tensor, **kwargs) -> torch.Tensor:\n",
    "        # Do not forward **kwargs — SDE drift/diffusion only take (x, t); avoids stray e.g. state_clip_abs.\n",
    "        return xt + self.sde.drift_coefficient(xt, t) * dt + self.sde.diffusion_coefficient(xt, t) * torch.sqrt(torch.abs(dt)) * torch.randn_like(xt)\n",
    "\n",
    "\n",
    "class HeunSimulator(Simulator):\n",
    "    \"\"\"\n",
    "    Second-order deterministic solver for the probability-flow ODE (sigma=0).\n",
    "    \"\"\"\n",
    "    def __init__(self, sde: SDE):\n",
    "        self.sde = sde\n",
    "\n",
    "    def step(self, xt: torch.Tensor, t: torch.Tensor, dt: torch.Tensor, **kwargs) -> torch.Tensor:\n",
    "        sigma = float(getattr(self.sde, 'sigma', 0.0))\n",
    "        if abs(sigma) > 1e-12:\n",
    "            raise ValueError('HeunSimulator expects sigma=0. Use Euler-Maruyama for stochastic sampling.')\n",
    "        drift_t = self.sde.drift_coefficient(xt, t)\n",
    "        x_pred = xt + drift_t * dt\n",
    "        t_next = t + dt\n",
    "        drift_next = self.sde.drift_coefficient(x_pred, t_next)\n",
    "        return xt + 0.5 * (drift_t + drift_next) * dt\n",
    "\n",
    "\n",
    "def build_sampler(sde: SDE) -> Simulator:\n",
    "    sigma = float(getattr(sde, 'sigma', 0.0))\n",
    "    if abs(sigma) < 1e-12:\n",
    "        return HeunSimulator(sde)\n",
    "    return EulerMaruyamaSimulator(sde)\n"
   ]
