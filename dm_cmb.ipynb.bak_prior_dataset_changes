    "class PriorSampler(nn.Module, Sampleable):\n",
    "    \"\"\"\n",
    "    Sampleable wrapper for a single prior patch dataset (CMB or foreground).\n",
    "    Keeps the train split for optimization and the validation split for diagnostics.\n",
    "    \"\"\"\n",
    "    def __init__(self, prior: Dict, subset_fraction: float = 1.0, split: str = \"train\"):\n",
    "        super().__init__()\n",
    "        self.train_patches_full = torch.from_numpy(prior[\"train_norm\"])\n",
    "        self.val_patches_full = torch.from_numpy(prior[\"val_norm\"])\n",
    "        n_use = max(1, int(len(self.train_patches_full) * subset_fraction))\n",
    "        self.train_patches = self.train_patches_full[:n_use]\n",
    "        self.val_patches = self.val_patches_full\n",
    "        self.split = split\n",
    "        self.dummy = nn.Buffer(torch.zeros(1))\n",
    "\n",
    "        if split == \"train\":\n",
    "            self.patches = self.train_patches\n",
    "        elif split == \"val\":\n",
    "            self.patches = self.val_patches\n",
    "        else:\n",
    "            raise ValueError(f\"Unknown split: {split}\")\n",
    "\n",
    "        print(\n",
    "            \"PriorSampler: \"\n",
    "            f\"train {len(self.train_patches)}/{len(self.train_patches_full)} \"\n",
    "            f\"(subset {subset_fraction*100:.0f}%), val {len(self.val_patches)}\"\n",
    "        )\n",
    "\n",
    "    def get_split_patches(self, split: str = \"train\") -> torch.Tensor:\n",
    "        if split == \"train\":\n",
    "            return self.train_patches\n",
    "        if split == \"val\":\n",
    "            if len(self.val_patches) == 0:\n",
    "                raise ValueError(\"Validation split is empty.\")\n",
    "            return self.val_patches\n",
    "        raise ValueError(f\"Unknown split: {split}\")\n",
    "\n",
    "    def get_split_numpy(self, split: str = \"train\") -> np.ndarray:\n",
    "        return self.get_split_patches(split).cpu().numpy()\n",
    "\n",
    "    def sample(self, num_samples: int, split: Optional[str] = None) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Args:\n",
    "            - num_samples: number of samples to sample\n",
    "            - split: optionally override the default split for this draw\n",
    "        Returns:\n",
    "            - samples: shape (num_samples, 3, 64, 64)\n",
    "        \"\"\"\n",
    "        patches = self.patches if split is None else self.get_split_patches(split)\n",
    "        n = len(patches)\n",
    "        if num_samples > n:\n",
    "            raise ValueError(f\"num_samples ({num_samples}) exceeds dataset size: {n}\")\n",
    "\n",
    "        idx = torch.randperm(n)[:num_samples]\n",
    "        return patches[idx].to(self.dummy.device)"
   ]
