    "\n",
    "def gaussian_smooth_patches_tqu(patches_tqu: np.ndarray, sigma_pix: float = 1.0) -> np.ndarray:\n",
    "    \"\"\"\n",
    "    Mild isotropic Gaussian smoothing on each T/Q/U map (same for train & gen).\n",
    "    Suppresses discretisation / Euler artefacts at high ell on small patches.\n",
    "    sigma_pix=0 returns input unchanged (caller should skip when 0).\n",
    "    \"\"\"\n",
    "    if sigma_pix <= 0:\n",
    "        return patches_tqu\n",
    "    from scipy.ndimage import gaussian_filter\n",
    "    out = np.empty_like(patches_tqu, dtype=np.float64)\n",
    "    for i in range(patches_tqu.shape[0]):\n",
    "        for ch in range(3):\n",
    "            out[i, ch] = gaussian_filter(\n",
    "                patches_tqu[i, ch].astype(np.float64), sigma_pix, mode=\"reflect\"\n",
    "            )\n",
    "    return out.astype(patches_tqu.dtype, copy=False)\n",
    "\n",
    "\n",
    "def gaussian_kernel1d_torch(sigma_pix: float, truncate: float = 3.0,\n",
    "                            device: Optional[torch.device] = None,\n",
    "                            dtype: Optional[torch.dtype] = None) -> torch.Tensor:\n",
    "    if sigma_pix <= 0:\n",
    "        raise ValueError('sigma_pix must be > 0 for gaussian_kernel1d_torch.')\n",
    "    radius = max(1, int(truncate * float(sigma_pix) + 0.5))\n",
    "    x = torch.arange(-radius, radius + 1, device=device, dtype=dtype)\n",
    "    kernel = torch.exp(-0.5 * (x / float(sigma_pix)) ** 2)\n",
    "    kernel = kernel / kernel.sum()\n",
    "    return kernel\n",
    "\n",
    "\n",
    "def gaussian_blur_torch(x: torch.Tensor, sigma_pix: float) -> torch.Tensor:\n",
    "    if sigma_pix <= 0:\n",
    "        return x\n",
    "    kernel_1d = gaussian_kernel1d_torch(\n",
    "        sigma_pix, device=x.device, dtype=x.dtype,\n",
    "    )\n",
    "    radius = kernel_1d.numel() // 2\n",
    "    channels = x.shape[1]\n",
    "    kernel_y = kernel_1d.view(1, 1, -1, 1).repeat(channels, 1, 1, 1)\n",
    "    kernel_x = kernel_1d.view(1, 1, 1, -1).repeat(channels, 1, 1, 1)\n",
    "    x = F.conv2d(x, kernel_y, padding=(radius, 0), groups=channels)\n",
    "    x = F.conv2d(x, kernel_x, padding=(0, radius), groups=channels)\n",
    "    return x"
