    "                 augment_train: bool = True,\n",
    "                 val_split: str = 'val', ref_split: str = 'val', **kwargs):\n",
    "        super().__init__(model, **kwargs)\n",
    "        if not (0.0 <= sample_t_min < sample_t_max <= 1.0):\n",
    "            raise ValueError('Expected 0 <= sample_t_min < sample_t_max <= 1.')\n",
    "        if train_t_bias_power <= 0.0:\n",
    "            raise ValueError('train_t_bias_power must be > 0. Use 1.0 for uniform sampling.')\n",
    "        self.path = path\n",
    "        self.num_t_bins = num_t_bins\n",
    "        self.val_batch_size = val_batch_size\n",
    "        self._fixed_val = None\n",
    "        self.sde_sigma = sde_sigma\n",
    "        self.spectral_n_samples = spectral_n_samples\n",
    "        self.spectral_n_steps = spectral_n_steps\n",
    "        self.reso_arcmin = reso_arcmin\n",
    "        self.spectral_smooth_sigma_pix = spectral_smooth_sigma_pix\n",
    "        self.spectral_ell_max = spectral_ell_max\n",
    "        self.sample_t_min = sample_t_min\n",
    "        self.sample_t_max = sample_t_max\n",
    "        self.train_t_bias_power = float(train_t_bias_power)\n",
    "        self.state_clip_abs = state_clip_abs\n",
    "        self.augment_train = bool(augment_train)\n",
    "        self.val_split = val_split\n",
    "        self.ref_split = ref_split\n",
    "        self._target_spectra = None  # (ells, dict TT/EE/BB/TE); same pipeline as post-training\n",
    "        self._target_spectra_label = None\n",
    "        self._target_tt = None  # legacy TT-only history\n",
    "\n",
    "    def build_sampling_sde(self) -> SDE:\n",
    "        return ScoreSDE(self.model, self.path.alpha, self.path.beta, sigma=self.sde_sigma)\n",
    "\n",
    "    def reconstruct_x0(self, x_t: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        eps_pred = self.model(x_t, t)\n",
    "        return self.path.reconstruct_x0_from_eps(x_t, eps_pred, t)\n",
    "\n",
    "    def _resolve_ref_patches(self) -> Tuple[np.ndarray, str]:\n",
    "        try:\n",
    "            return self.path.p_data.get_split_numpy(self.ref_split), self.ref_split\n",
    "        except ValueError:\n",
    "            return self.path.p_data.get_split_numpy('train'), 'train'\n",
    "\n",
    "    def _build_fixed_val(self, device: torch.device):\n",
    "        \"\"\"Build a fixed validation set once for stable monitoring.\"\"\"\n",
    "        with torch.no_grad():\n",
    "            try:\n",
    "                z = self.path.p_data.sample(self.val_batch_size, split=self.val_split)\n",
    "            except ValueError:\n",
    "                z = self.path.p_data.sample(self.val_batch_size, split='train')\n",
    "            t = torch.linspace(self.sample_t_min, self.sample_t_max, self.val_batch_size, device=device).view(-1, 1, 1, 1)\n",
    "            eps = torch.randn_like(z)\n",
    "            alpha_t = self.path.alpha(t)\n",
    "            beta_t = self.path.beta(t)\n",
    "            x_t = alpha_t * z + beta_t * eps\n",
    "        self._fixed_val = {'z': z, 'x_t': x_t, 't': t, 'eps': eps,\n",
    "                           'alpha_t': alpha_t, 'beta_t': beta_t}\n",
    "\n",
    "    def _sample_train_t(self, batch_size: int, device: torch.device) -> torch.Tensor:\n",
    "        \"\"\"Sample training timesteps in [sample_t_min, sample_t_max].\n",
    "        train_t_bias_power=1 gives uniform sampling; values >1 bias draws toward high t,\n",
    "        while values in (0, 1) bias draws toward low t.\n",
    "        \"\"\"\n",
    "        u = torch.rand(batch_size, 1, 1, 1, device=device)\n",
    "        if abs(self.train_t_bias_power - 1.0) < 1e-12:\n",
    "            tau = u\n",
    "        else:\n",
    "            tau = 1.0 - torch.pow(1.0 - u, self.train_t_bias_power)\n",
    "        return self.sample_t_min + (self.sample_t_max - self.sample_t_min) * tau\n",
    "\n",
    "    def get_train_loss(self, batch_size: int) -> torch.Tensor:\n",
    "        z = self.path.p_data.sample(batch_size)\n",
    "        if self.augment_train:\n",
    "            z = _d4_augment_tqu(z)\n",
    "        t = self._sample_train_t(batch_size, z.device)\n",
    "        eps = torch.randn_like(z)\n",
    "        alpha_t = self.path.alpha(t)\n",
    "        beta_t = self.path.beta(t)\n",
    "        x_t = alpha_t * z + beta_t * eps\n",
    "        eps_pred = self.model(x_t, t)\n",
    "        loss = torch.mean((eps_pred - eps) ** 2)\n",
    "        return loss\n",
    "\n",
    "    def run_diagnostics(self, epoch: int, device: torch.device, **kwargs):\n",
    "        \"\"\"Called periodically from Trainer.train with model in eval mode.\"\"\"\n",
    "        if self._fixed_val is None:\n",
    "            self._build_fixed_val(device)\n",
    "\n",
    "        fv = self._fixed_val\n",
    "        eps_pred = self.model(fv['x_t'], fv['t'])\n",
    "\n",
    "        # Noise-prediction MSE (L_val,eps)\n",
    "        per_sample_mse = torch.mean((eps_pred - fv['eps']) ** 2, dim=(1, 2, 3))\n",
    "        self._record('val_loss_eps', per_sample_mse.mean().item())\n",
    "\n",
    "        # x0-reconstruction MSE (L_val,x0)\n",
    "        x0_hat = self.path.reconstruct_x0_from_eps(fv['x_t'], eps_pred, fv['t'])\n",
    "        x0_mse = torch.mean((fv['z'] - x0_hat) ** 2, dim=(1, 2, 3))\n",
    "        self._record('val_loss_x0', x0_mse.mean().item())\n",
    "\n",
    "        # Validation loss by timestep bin\n",
    "        t_flat = fv['t'].view(-1)\n",
    "        bin_edges = torch.linspace(0.0, 1.0, self.num_t_bins + 1, device=device)\n",
    "        for b in range(self.num_t_bins):\n",
    "            lo, hi = bin_edges[b].item(), bin_edges[b + 1].item()\n",
    "            mask = (t_flat >= lo) & (t_flat < hi)\n",
    "            if mask.any():\n",
    "                bin_loss = per_sample_mse[mask].mean().item()\n",
    "            else:\n",
    "                bin_loss = float('nan')\n",
    "            self._record(f'val_loss_t_{lo:.1f}_{hi:.1f}', bin_loss)\n",
    "\n",
    "    def run_spectral_diagnostics(self, epoch: int, device: torch.device, **kwargs):\n",
    "        \"\"\"Reverse samples; compare generated spectra against a held-out reference split.\"\"\"\n",
    "        ref_patches, ref_split_used = self._resolve_ref_patches()\n",
    "        ref_label = 'validation' if ref_split_used == 'val' else 'training'\n",
    "        sig = self.spectral_smooth_sigma_pix\n",
    "        if sig and float(sig) > 0:\n",
    "            ref_sp = gaussian_smooth_patches_tqu(ref_patches, float(sig))\n",
    "        else:\n",
    "            ref_sp = ref_patches\n",
    "\n",
    "        if self._target_spectra is None:\n",
    "            ells_ref, spectra_ref = flat_sky_full_spectra(ref_sp, self.reso_arcmin)\n",
    "            em = self.spectral_ell_max\n",
    "            if em is not None:\n",
    "                keep = ells_ref <= float(em)\n",
    "                ells_ref = ells_ref[keep]\n",
    "                spectra_ref = {k: v[keep] for k, v in spectra_ref.items()}\n",
    "            self._target_spectra = (ells_ref, spectra_ref)\n",
    "            self._target_spectra_label = ref_label\n",
    "\n",
    "        sde = self.build_sampling_sde()\n",
    "        simulator = build_sampler(sde)\n",
    "\n",
    "        bs = self.spectral_n_samples\n",
    "        x0 = torch.randn(bs, 3, 64, 64, device=device)\n",
    "        ts_1d = torch.linspace(self.sample_t_min, self.sample_t_max, self.spectral_n_steps, device=device)\n",
    "        ts = ts_1d.view(1, -1, 1, 1, 1).expand(bs, -1, -1, -1, -1)\n",
    "\n",
    "        xt_final = simulator.simulate(x0, ts, state_clip_abs=self.state_clip_abs)\n",
    "        clip_frac = 0.0\n",
    "        if self.state_clip_abs is not None:\n",
    "            clip_thr = float(self.state_clip_abs) - 1e-6\n",
    "            clip_frac = float(torch.mean((torch.abs(xt_final) >= clip_thr).float()).item())\n",
    "\n",
    "        t_final = torch.full((bs, 1, 1, 1), self.sample_t_max, device=device)\n",
    "        # The simulator returns x_t at t = sample_t_max, not clean data. Reconstruct x0_hat\n",
    "        # using the trainer's parameterization before spectral comparison.\n",
    "        samples = self.reconstruct_x0(xt_final, t_final).cpu().numpy()\n",
    "\n",
    "        if sig and float(sig) > 0:\n",
    "            gen_sp = gaussian_smooth_patches_tqu(samples, float(sig))\n",
    "        else:\n",
    "            gen_sp = samples\n",
    "\n",
    "        ells_g, spectra_gen = flat_sky_full_spectra(gen_sp, self.reso_arcmin)\n",
    "        em = self.spectral_ell_max\n",
    "        if em is not None:\n",
    "            keep = ells_g <= float(em)\n",
    "            ells_g = ells_g[keep]\n",
    "            spectra_gen = {k: v[keep] for k, v in spectra_gen.items()}\n",
    "\n",
    "        _tr = np.array([ref_sp[:, c].std() for c in range(3)])\n",
    "        _ge = np.array([gen_sp[:, c].std() for c in range(3)])\n",
    "        _sc = _tr / np.where(_ge > 1e-12, _ge, 1.0)\n",
    "        gen_vm_sp = gen_sp * _sc.reshape(1, 3, 1, 1)\n",
    "        ells_vm, spectra_vm = flat_sky_full_spectra(gen_vm_sp, self.reso_arcmin)\n",
    "        if em is not None:\n",
    "            keep_vm = ells_vm <= float(em)\n",
    "            ells_vm = ells_vm[keep_vm]\n",
    "            spectra_vm = {k: v[keep_vm] for k, v in spectra_vm.items()}\n",
    "\n",
    "        ref_ells, ref_spec = self._target_spectra\n",
    "        dl_ref = ref_ells * (ref_ells + 1) / (2 * np.pi)\n",
    "\n",
    "        def _spec_log_mse(spec_a: Dict[str, np.ndarray], spec_b: Dict[str, np.ndarray],\n",
    "                          names: Tuple[str, ...] = ('TT', 'EE', 'BB')) -> float:\n",
    "            vals = []\n",
    "            for name in names:\n",
    "                a = dl_ref * np.asarray(spec_a[name], dtype=np.float64)\n",
    "                b = dl_ref * np.asarray(spec_b[name], dtype=np.float64)\n",
    "                mask = np.isfinite(a) & np.isfinite(b) & (a > 1e-12) & (b > 1e-12)\n",
    "                if np.any(mask):\n",
    "                    vals.append(float(np.mean((np.log(a[mask]) - np.log(b[mask])) ** 2)))\n",
    "            return float(np.mean(vals)) if vals else float('nan')\n",
    "\n",
    "        def _tt_rel_l2(spec_a: Dict[str, np.ndarray], spec_b: Dict[str, np.ndarray]) -> float:\n",
    "            a = dl_ref * np.asarray(spec_a['TT'], dtype=np.float64)\n",
    "            b = dl_ref * np.asarray(spec_b['TT'], dtype=np.float64)\n",
    "            mask = np.isfinite(a) & np.isfinite(b) & (np.abs(b) > 1e-12)\n",
    "            if not np.any(mask):\n",
    "                return float('nan')\n",
    "            rel = (a[mask] - b[mask]) / b[mask]\n",
    "            return float(np.sqrt(np.mean(rel ** 2)))\n",
    "\n",
    "        def _std_log_l2(gen_std: np.ndarray, ref_std: np.ndarray) -> float:\n",
    "            gen_std = np.asarray(gen_std, dtype=np.float64)\n",
    "            ref_std = np.asarray(ref_std, dtype=np.float64)\n",
    "            mask = np.isfinite(gen_std) & np.isfinite(ref_std) & (gen_std > 1e-12) & (ref_std > 1e-12)\n",
    "            if not np.any(mask):\n",
    "                return float('nan')\n",
    "            diff = np.log(gen_std[mask]) - np.log(ref_std[mask])\n",
    "            return float(np.sqrt(np.mean(diff ** 2)))\n",
    "\n",
    "        spectral_log_mse_raw = _spec_log_mse(spectra_gen, ref_spec)\n",
    "        spectral_log_mse_vm = _spec_log_mse(spectra_vm, ref_spec)\n",
    "        spectral_tt_rel_l2_raw = _tt_rel_l2(spectra_gen, ref_spec)\n",
    "        spectral_tt_rel_l2_vm = _tt_rel_l2(spectra_vm, ref_spec)\n",
    "        spectral_std_log_l2 = _std_log_l2(_ge, _tr)\n",
    "        spectral_shape_log_rmse = float(np.sqrt(max(spectral_log_mse_raw, 0.0))) if np.isfinite(spectral_log_mse_raw) else float('nan')\n",
    "        spectral_selection_score = (\n",
    "            spectral_shape_log_rmse + spectral_std_log_l2\n",
    "            if np.isfinite(spectral_shape_log_rmse) and np.isfinite(spectral_std_log_l2)\n",
    "            else float('nan')\n",
    "        )\n",
    "\n",
    "        self._record('spectral_epoch', epoch)\n",
    "        self._record('spectral_clip_frac', clip_frac)\n",
    "        self._record('spectral_log_mse_raw', spectral_log_mse_raw)\n",
    "        self._record('spectral_log_mse_vm', spectral_log_mse_vm)\n",
    "        self._record('spectral_tt_rel_l2_raw', spectral_tt_rel_l2_raw)\n",
    "        self._record('spectral_tt_rel_l2_vm', spectral_tt_rel_l2_vm)\n",
    "        self._record('spectral_std_log_l2', spectral_std_log_l2)\n",
    "        self._record('spectral_selection_score', spectral_selection_score)\n",
    "        if np.isfinite(spectral_selection_score):\n",
    "            if self.best_spectral_score is None or spectral_selection_score < self.best_spectral_score:\n",
    "                self.best_spectral_score = float(spectral_selection_score)\n",
    "                self.best_spectral_epoch = int(epoch)\n",
    "                self.best_spectral_model_state_dict = {\n",
    "                    k: v.detach().cpu().clone() for k, v in self.model.state_dict().items()\n",
    "                }\n",
    "                ema_state = self.ema_state_dict()\n",
    "                self.best_spectral_ema_state_dict = None if ema_state is None else {\n",
    "                    'decay': float(ema_state['decay']),\n",
    "                    'shadow': {k: v.clone() for k, v in ema_state['shadow'].items()},\n",
    "                }\n",
    "        self._record('best_spectral_score_so_far', float(self.best_spectral_score) if self.best_spectral_score is not None else float('nan'))\n",
    "        self._record('best_spectral_epoch_so_far', float(self.best_spectral_epoch) if self.best_spectral_epoch is not None else float('nan'))\n",
    "        self.history.setdefault('spectral_ells', ref_ells)\n",
    "        self.history['spectral_representation'] = 'x0_hat'\n",
    "        self.history.setdefault('spectral_gen', []).append(spectra_gen)\n",
    "        self.history.setdefault('spectral_gen_vm', []).append(spectra_vm)\n",
    "\n",
    "    def _live_plot(self, epoch: int):\n",
    "        \"\"\"Refresh inline plots during training.\"\"\"\n",
    "        from IPython.display import clear_output, display\n",
    "        clear_output(wait=True)\n",
    "\n",
    "        has_spectral = (\n",
    "            self._target_spectra is not None\n",
    "            and 'spectral_gen' in self.history\n",
    "            and len(self.history['spectral_gen']) > 0\n",
    "        )\n",
    "        ncols = 3 if has_spectral else 2\n",
    "        fig, axes = plt.subplots(2, ncols, figsize=(7 * ncols, 10))\n",
    "\n",
    "        # --- Top-left: Training minibatch loss over epochs + held-out validation checkpoints ---\n",
    "        ax = axes[0, 0]\n",
    "        losses = self.history.get('train_loss', [])\n",
    "        ax.plot(losses, alpha=0.3, color='C0', label='train minibatch (raw)')\n",
    "        if len(losses) > 20:\n",
    "            window = max(10, len(losses) // 50)\n",
    "            smoothed = np.convolve(losses, np.ones(window)/window, mode='valid')\n",
    "            ax.plot(np.arange(window-1, window-1+len(smoothed)), smoothed,\n",
    "                    color='C0', linewidth=2, label=f'train minibatch (smooth, w={window})')\n",
    "        val_key = self.validation_metric_key if self.validation_metric_key in self.history else ('val_loss_eps' if 'val_loss_eps' in self.history else None)\n",
    "        vals_eps_overlay = self.history.get(val_key, []) if val_key is not None else []\n",
    "        pred_label = getattr(self, 'prediction_name', 'prediction')\n",
    "        diag_epochs = self.history.get('diag_epoch', [])\n",
    "        if vals_eps_overlay and diag_epochs:\n",
    "            n = min(len(diag_epochs), len(vals_eps_overlay))\n",
    "            ax.scatter(diag_epochs[:n], vals_eps_overlay[:n],\n",
    "                       color='C1', s=20, zorder=5, label=f'held-out val checkpoints ({pred_label})')\n",
    "        # Log scale hides slow relative improvements; use linear when variation is small\n",
    "        arr = np.asarray(losses, dtype=float)\n",
    "        if arr.size > 1:\n",
    "            lo, hi = np.nanmin(arr), np.nanmax(arr)\n",
    "            if lo > 0 and hi / lo < 1.25:\n",
    "                ax.set_yscale('linear')\n",
    "                ax.set_ylabel(f'{pred_label} MSE (linear)')\n",
    "            else:\n",
    "                ax.set_yscale('log')\n",
    "                ax.set_ylabel(f'{pred_label} MSE (log)')\n",
    "        else:\n",
    "            ax.set_yscale('log')\n",
    "            ax.set_ylabel(f'{pred_label} MSE')\n",
    "        ax.set_xlabel('Epoch')\n",
    "        ax.set_title(f'Train minibatch loss + held-out validation checkpoints (epoch {epoch})')\n",
    "        ax.legend(); ax.grid(True, alpha=0.3)\n",
    "\n",
    "        # --- Top-right: primary validation loss ---\n",
    "        ax = axes[0, 1]\n",
    "        vals_eps = self.history.get(val_key, []) if val_key is not None else []\n",
    "        if vals_eps:\n",
    "            ax.plot(vals_eps, marker='o', markersize=3, color='C1')\n",
    "        ax.set_xlabel('Diagnostic step'); ax.set_ylabel('MSE')\n",
    "        ax.set_title(f'Primary validation loss ({pred_label})')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "\n",
    "        # --- Bottom-left: x0 reconstruction validation (L_val,x0) ---\n",
    "        ax = axes[1, 0]\n",
    "        vals_x0 = self.history.get('val_loss_x0', [])\n",
    "        if vals_x0:\n",
    "            ax.plot(vals_x0, marker='o', markersize=3, color='C2')\n",
    "        ax.set_xlabel('Diagnostic step'); ax.set_ylabel('MSE')\n",
    "        ax.set_title(r'$L_{\\mathrm{val},x_0}$ (reconstruction)')\n",
    "        ax.grid(True, alpha=0.3)\n",
    "\n",
    "        # --- Bottom-middle: Latest validation loss by timestep bin ---\n",
    "        ax = axes[1, 1]\n",
    "        bin_keys = sorted([k for k in self.history if k.startswith('val_loss_t_')])\n",
    "        if bin_keys:\n",
    "            bin_labels, bin_vals = [], []\n",
    "            for k in bin_keys:\n",
    "                vals = self.history[k]\n",
    "                if vals:\n",
    "                    parts = k.replace('val_loss_t_', '').split('_')\n",
    "                    if len(parts) != 2:\n",
    "                        continue\n",
    "                    lo, hi = parts\n",
    "                    bin_labels.append(f'{lo}-{hi}')\n",
    "                    bin_vals.append(vals[-1])\n",
    "            if bin_labels:\n",
    "                ax.bar(bin_labels, bin_vals, color='C3', edgecolor='black')\n",
    "                ax.set_xlabel('Timestep bin'); ax.set_ylabel('Validation MSE')\n",
    "                ax.set_title(f'Loss by timestep (epoch {epoch})')\n",
    "                ax.grid(True, alpha=0.3, axis='y')\n",
    "            else:\n",
    "                ax.set_title('Waiting for diagnostics...')\n",
    "        else:\n",
    "            ax.set_title('Waiting for diagnostics...')\n",
    "\n",
    "        # --- TT spectrum only: held-out reference vs raw generated snapshots ---\n",
    "        if has_spectral:\n",
    "            ax = axes[0, 2]\n",
    "            ells = self.history['spectral_ells']\n",
    "            ref_spec = self._target_spectra[1]\n",
    "            dl_fac = ells * (ells + 1) / (2 * np.pi)\n",
    "            ref_vals = dl_fac * ref_spec['TT']\n",
    "            ref_label = self._target_spectra_label or 'reference'\n",
    "            ax.plot(ells, ref_vals, 'k-', linewidth=2, label=ref_label)\n",
    "            epochs_s = self.history.get('spectral_epoch', [])\n",
    "            gen_list = self.history['spectral_gen']\n",
    "            n_snaps = len(gen_list)\n",
    "            cmap_s = plt.cm.viridis\n",
    "            for i, sg in enumerate(gen_list):\n",
    "                ep = epochs_s[i] if i < len(epochs_s) else i\n",
    "                ax.plot(ells, dl_fac * sg['TT'], alpha=0.75,\n",
    "                        color=cmap_s(i / max(n_snaps - 1, 1)), label=f'epoch {ep}')\n",
    "            ax.set_xlabel(r'$\\ell$')\n",
    "            ax.set_ylabel(r'$D_\\ell^{TT}$')\n",
    "            clip_vals = self.history.get('spectral_clip_frac', [])\n",
    "            tt_rel_vals = self.history.get('spectral_tt_rel_l2_raw', [])\n",
    "            clip_note = f', clip_frac={clip_vals[-1]:.3f}' if clip_vals else ''\n",
    "            tt_note = f', TTrel={tt_rel_vals[-1]:.2f}' if tt_rel_vals else ''\n",
    "            ax.set_title(\n",
    "                f'TT (denoised x0_hat; smooth={self.spectral_smooth_sigma_pix}px, '\n",
    "                f'ell_max={self.spectral_ell_max}{clip_note}{tt_note})'\n",
    "            )\n",
    "            ax.set_xscale('log')\n",
    "            ax.grid(True, alpha=0.3)\n",
    "            ax.legend(fontsize=7, loc='upper right')\n",
    "\n",
    "            axm = axes[1, 2]\n",
    "            if clip_vals:\n",
    "                axm.plot(epochs_s[:len(clip_vals)], clip_vals, marker='o', color='C3', label='clip_frac')\n",
    "            if tt_rel_vals:\n",
    "                axm.plot(epochs_s[:len(tt_rel_vals)], tt_rel_vals, marker='o', color='C4', label='TT rel L2 (raw)')\n",
    "            spectral_score_vals = self.history.get('spectral_selection_score', [])\n",
    "            if spectral_score_vals:\n",
    "                axm.plot(epochs_s[:len(spectral_score_vals)], spectral_score_vals, marker='o', color='C0', label='spectral score')\n",
    "            best_score_vals = self.history.get('best_spectral_score_so_far', [])\n",
    "            if best_score_vals:\n",
    "                axm.plot(epochs_s[:len(best_score_vals)], best_score_vals, linestyle='--', color='0.35', label='best spectral score')\n",
    "            axm.set_xlabel('Epoch')\n",
    "            axm.set_ylabel('Metric value')\n",
    "            axm.set_title('Sampling diagnostics (lower is better)')\n",
    "            axm.grid(True, alpha=0.3)\n",
    "            axm.legend(fontsize=8)\n",
    "\n",
    "        plt.tight_layout()\n",
    "        display(fig)\n",
    "        plt.close(fig)\n",
    "\n",
    "\n",
    "class FlowMatchingTrainer(DDPMTrainer):\n",
    "    \"\"\"Direct vector-field training on the path's conditional velocity target.\"\"\"\n",
    "    prediction_name = 'vector field'\n",
    "    validation_metric_key = 'val_loss_field'\n",
    "\n",
    "    def __init__(self, *args, x0_loss_weight: float = 0.25,\n",
    "                 lowfreq_t_loss_weight: float = 0.0,\n",
    "                 lowfreq_t_sigmas: Tuple[float, ...] = (2.0,),\n",
    "                 smoothed_var_loss_weight: float = 0.0,\n",
    "                 smoothed_var_sigma_pix: float = 1.2,\n",
    "                 radial_power_loss_weight: float = 0.0,\n",
    "                 aux_ramp_start_epoch: int = 0,\n",
    "                 aux_ramp_full_epoch: int = 0,\n",
    "                 aux_ramp_decay_epoch: int = 0,\n",
    "                 aux_final_scale: float = 1.0, **kwargs):\n",
    "        super().__init__(*args, **kwargs)\n",
    "        if x0_loss_weight < 0.0:\n",
    "            raise ValueError('x0_loss_weight must be >= 0.')\n",
    "        self.x0_loss_weight = float(x0_loss_weight)\n",
    "        if lowfreq_t_loss_weight < 0.0:\n",
    "            raise ValueError('lowfreq_t_loss_weight must be >= 0.')\n",
    "        self.lowfreq_t_loss_weight = float(lowfreq_t_loss_weight)\n",
    "        self.lowfreq_t_sigmas = tuple(float(s) for s in lowfreq_t_sigmas if float(s) > 0.0)\n",
    "        if smoothed_var_loss_weight < 0.0:\n",
    "            raise ValueError('smoothed_var_loss_weight must be >= 0.')\n",
    "        self.smoothed_var_loss_weight = float(smoothed_var_loss_weight)\n",
    "        self.smoothed_var_sigma_pix = float(smoothed_var_sigma_pix)\n",
    "        if radial_power_loss_weight < 0.0:\n",
    "            raise ValueError('radial_power_loss_weight must be >= 0.')\n",
    "        self.radial_power_loss_weight = float(radial_power_loss_weight)\n",
    "        self.aux_ramp_start_epoch = max(int(aux_ramp_start_epoch), 0)\n",
    "        self.aux_ramp_full_epoch = max(int(aux_ramp_full_epoch), self.aux_ramp_start_epoch)\n",
    "        self.aux_ramp_decay_epoch = max(int(aux_ramp_decay_epoch), self.aux_ramp_full_epoch)\n",
    "        if aux_final_scale < 0.0 or aux_final_scale > 1.0:\n",
    "            raise ValueError('aux_final_scale must lie in [0, 1].')\n",
    "        self.aux_final_scale = float(aux_final_scale)\n",
    "\n",
    "    def _aux_loss_scale(self, epoch: Optional[int] = None) -> float:\n",
    "        if epoch is None:\n",
    "            epoch = getattr(self, '_train_epoch', 0)\n",
    "        start = self.aux_ramp_start_epoch\n",
    "        full = self.aux_ramp_full_epoch\n",
    "        decay = self.aux_ramp_decay_epoch\n",
    "        final_scale = self.aux_final_scale\n",
    "        if full <= start:\n",
    "            base = 1.0 if epoch >= start else 0.0\n",
    "        elif epoch <= start:\n",
    "            base = 0.0\n",
    "        elif epoch >= full:\n",
    "            base = 1.0\n",
    "        else:\n",
    "            base = float(epoch - start) / float(full - start)\n",
    "        if base < 1.0 or abs(final_scale - 1.0) < 1e-12 or decay <= full:\n",
    "            return base\n",
    "        if epoch >= decay:\n",
    "            return final_scale\n",
    "        frac = float(epoch - full) / float(decay - full)\n",
    "        return (1.0 - frac) + frac * final_scale\n",
    "\n",
    "    def _build_fixed_val(self, device: torch.device):\n",
    "        with torch.no_grad():\n",
    "            try:\n",
    "                z = self.path.p_data.sample(self.val_batch_size, split=self.val_split)\n",
    "            except ValueError:\n",
    "                z = self.path.p_data.sample(self.val_batch_size, split='train')\n",
    "            t = torch.linspace(self.sample_t_min, self.sample_t_max, self.val_batch_size, device=device).view(-1, 1, 1, 1)\n",
    "            eps = torch.randn_like(z)\n",
    "            alpha_t = self.path.alpha(t)\n",
    "            beta_t = self.path.beta(t)\n",
    "            x_t = alpha_t * z + beta_t * eps\n",
    "            u_t = self.path.alpha.dt(t) * z + self.path.beta.dt(t) * eps\n",
    "        self._fixed_val = {'z': z, 'x_t': x_t, 't': t, 'eps': eps,\n",
    "                           'alpha_t': alpha_t, 'beta_t': beta_t, 'u_t': u_t}\n",
    "\n",
    "    def build_sampling_sde(self) -> SDE:\n",
    "        return VectorFieldODE(self.model)\n",
    "\n",
    "    def reconstruct_x0(self, x_t: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        v_pred = self.model(x_t, t)\n",
    "        return self.path.reconstruct_x0_from_vector_field(x_t, v_pred, t)\n",
    "\n",
    "    def _lowfreq_t_loss(self, x0_hat: torch.Tensor, z: torch.Tensor) -> torch.Tensor:\n",
    "        if self.lowfreq_t_loss_weight <= 0.0 or len(self.lowfreq_t_sigmas) == 0:\n",
    "            return x0_hat.new_tensor(0.0)\n",
    "        x_t = x0_hat[:, 0:1]\n",
    "        z_t = z[:, 0:1]\n",
    "        loss = x0_hat.new_tensor(0.0)\n",
    "        for sigma in self.lowfreq_t_sigmas:\n",
    "            x_blur = gaussian_blur_torch(x_t, sigma)\n",
    "            z_blur = gaussian_blur_torch(z_t, sigma)\n",
    "            loss = loss + torch.mean((x_blur - z_blur) ** 2)\n",
    "        return loss / float(len(self.lowfreq_t_sigmas))\n",
    "\n",
    "    def _smoothed_var_match_loss(self, x0_hat: torch.Tensor, z: torch.Tensor) -> torch.Tensor:\n",
    "        if self.smoothed_var_loss_weight <= 0.0 or self.smoothed_var_sigma_pix <= 0.0:\n",
    "            return x0_hat.new_tensor(0.0)\n",
    "        x_blur = gaussian_blur_torch(x0_hat, self.smoothed_var_sigma_pix)\n",
    "        z_blur = gaussian_blur_torch(z, self.smoothed_var_sigma_pix)\n",
    "        dims = (0, 2, 3)\n",
    "        var_x = torch.var(x_blur, dim=dims, unbiased=False)\n",
    "        var_z = torch.var(z_blur, dim=dims, unbiased=False)\n",
    "        log_var_x = torch.log(var_x + 1e-6)\n",
    "        log_var_z = torch.log(var_z + 1e-6)\n",
    "        return torch.mean((log_var_x - log_var_z) ** 2)\n",
    "\n",
    "    def _radial_power_loss(self, x0_hat: torch.Tensor, z: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"Per-mode log-power MSE in the 2D Fourier domain.\n",
    "\n",
    "        Cheap, differentiable Fourier-domain regulariser. With B samples per\n",
    "        batch, each mode's expected power is estimated to O(1/B); matching the\n",
    "        log-power penalises both amplitude and shape mismatches, which is what\n",
    "        the downstream flat-sky D_l comparison evaluates.\n",
    "        \"\"\"\n",
    "        p_hat = (torch.fft.fft2(x0_hat).abs() ** 2).mean(dim=0)\n",
    "        p_z = (torch.fft.fft2(z).abs() ** 2).mean(dim=0)\n",
    "        return (torch.log(p_hat + 1e-8) - torch.log(p_z + 1e-8)).pow(2).mean()\n",
    "\n",
    "    def get_train_loss(self, batch_size: int) -> torch.Tensor:\n",
    "        z = self.path.p_data.sample(batch_size)\n",
    "        if self.augment_train:\n",
    "            z = _d4_augment_tqu(z)\n",
    "        t = self._sample_train_t(batch_size, z.device)\n",
    "        eps = torch.randn_like(z)\n",
    "        alpha_t = self.path.alpha(t)\n",
    "        beta_t = self.path.beta(t)\n",
    "        x_t = alpha_t * z + beta_t * eps\n",
    "        target_v = self.path.alpha.dt(t) * z + self.path.beta.dt(t) * eps\n",
    "        v_pred = self.model(x_t, t)\n",
    "        loss_v = torch.mean((v_pred - target_v) ** 2)\n",
    "        x0_hat = self.path.reconstruct_x0_from_vector_field(x_t, v_pred, t)\n",
    "        total_loss = loss_v\n",
    "        aux_scale = self._aux_loss_scale()\n",
    "        if self.x0_loss_weight > 0.0:\n",
    "            loss_x0 = torch.mean((x0_hat - z) ** 2)\n",
    "            total_loss = total_loss + self.x0_loss_weight * loss_x0\n",
    "        if self.lowfreq_t_loss_weight > 0.0 and aux_scale > 0.0:\n",
    "            loss_t_lowfreq = self._lowfreq_t_loss(x0_hat, z)\n",
    "            total_loss = total_loss + aux_scale * self.lowfreq_t_loss_weight * loss_t_lowfreq\n",
    "        if self.smoothed_var_loss_weight > 0.0 and aux_scale > 0.0:\n",
    "            loss_var = self._smoothed_var_match_loss(x0_hat, z)\n",
    "            total_loss = total_loss + aux_scale * self.smoothed_var_loss_weight * loss_var\n",
    "        if self.radial_power_loss_weight > 0.0:\n",
    "            loss_radial = self._radial_power_loss(x0_hat, z)\n",
    "            total_loss = total_loss + self.radial_power_loss_weight * loss_radial\n",
    "        return total_loss\n",
    "\n",
    "    def run_diagnostics(self, epoch: int, device: torch.device, **kwargs):\n",
    "        if self._fixed_val is None:\n",
    "            self._build_fixed_val(device)\n",
    "\n",
    "        fv = self._fixed_val\n",
    "        v_pred = self.model(fv['x_t'], fv['t'])\n",
    "        per_sample_mse = torch.mean((v_pred - fv['u_t']) ** 2, dim=(1, 2, 3))\n",
    "        zero_field_mse = torch.mean(fv['u_t'] ** 2, dim=(1, 2, 3))\n",
    "        self._record('val_loss_field', per_sample_mse.mean().item())\n",
    "        self._record('val_loss_field_zero', zero_field_mse.mean().item())\n",
    "\n",
    "        x0_hat = self.path.reconstruct_x0_from_vector_field(fv['x_t'], v_pred, fv['t'])\n",
    "        x0_mse = torch.mean((fv['z'] - x0_hat) ** 2, dim=(1, 2, 3))\n",
    "        self._record('val_loss_x0', x0_mse.mean().item())\n",
    "        self._record('aux_loss_scale', self._aux_loss_scale(epoch))\n",
    "        if self.lowfreq_t_loss_weight > 0.0 and len(self.lowfreq_t_sigmas) > 0:\n",
    "            lowfreq_val = self._lowfreq_t_loss(x0_hat, fv['z'])\n",
    "            self._record('val_loss_t_lowfreq', lowfreq_val.item())\n",
    "        if self.smoothed_var_loss_weight > 0.0 and self.smoothed_var_sigma_pix > 0.0:\n",
    "            var_val = self._smoothed_var_match_loss(x0_hat, fv['z'])\n",
    "            self._record('val_loss_var_smoothed', var_val.item())\n",
    "        if self.radial_power_loss_weight > 0.0:\n",
    "            radial_val = self._radial_power_loss(x0_hat, fv['z'])\n",
    "            self._record('val_loss_radial_power', radial_val.item())\n",
    "\n",
    "        t_flat = fv['t'].view(-1)\n",
    "        bin_edges = torch.linspace(0.0, 1.0, self.num_t_bins + 1, device=device)\n",
    "        for b in range(self.num_t_bins):\n",
    "            lo, hi = bin_edges[b].item(), bin_edges[b + 1].item()\n",
    "            mask = (t_flat >= lo) & (t_flat < hi)\n",
    "            if mask.any():\n",
    "                bin_loss = per_sample_mse[mask].mean().item()\n",
    "            else:\n",
    "                bin_loss = float('nan')\n",
    "            self._record(f'val_loss_t_{lo:.1f}_{hi:.1f}', bin_loss)\n"
   ]
