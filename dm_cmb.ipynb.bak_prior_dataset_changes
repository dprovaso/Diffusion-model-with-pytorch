    "        # For bounded schedules, respect the explicit endpoint floors; for legacy linear\n",
    "        # checkpoints, fall back to a small positive clamp.\n",
    "        floor = max(\n",
    "            5e-3,\n",
    "            min(\n",
    "                float(getattr(self.alpha, 'alpha_floor', 0.0)),\n",
    "                float(getattr(self.beta, 'beta_floor', 0.0)),\n",
    "            ),\n",
    "        )\n",
    "        alpha_s = alpha_t.clamp(min=floor)\n",
    "        beta_s = beta_t.clamp(min=floor)\n",
    "\n",
    "        eps = self.eps_net(x, t)\n",
    "        score = -eps / beta_s\n",
    "\n",
    "        u_coeff = beta_t**2 * dt_alpha / alpha_s - dt_beta * beta_t\n",
