    "MiB = 1024**2\n",
    "### I wouldn’t depend on the stored size, as the file might be compressed, compute instead ###\n",
    "def model_size_b(model: nn.Module) -> int: \n",
    "    \"\"\"\n",
    "    Returns model size in bytes. Based on https://discuss.pytorch.org/t/finding-model-size/130275/2\n",
    "    Args:\n",
    "    - model: self-explanatory\n",
    "    Returns:\n",
    "    - size: model size in bytes\n",
    "    \"\"\"\n",
    "    size = 0\n",
    "    for param in model.parameters():\n",
    "        size += param.numel() * param.element_size()\n",
    "    for buf in model.buffers():\n",
    "        size += buf.numel() * buf.element_size()\n",
    "    return size\n",
    "\n",
    "\n",
    "class ModelEMA:\n",
    "    \"\"\"Simple exponential moving average of model weights for evaluation/sampling.\"\"\"\n",
    "    def __init__(self, model: nn.Module, decay: float = 0.999):\n",
    "        if not (0.0 < decay < 1.0):\n",
    "            raise ValueError('EMA decay must lie in (0, 1).')\n",
    "        self.decay = float(decay)\n",
    "        # Only EMA floating-point tensors. Integer buffers (e.g. batch counters)\n",
    "        # can't be multiplied by a fractional decay; non-floating buffers are left\n",
    "        # untouched on the live model when we copy/restore.\n",
    "        self.shadow = {\n",
    "            k: v.detach().cpu().clone()\n",
    "            for k, v in model.state_dict().items()\n",
    "            if v.is_floating_point()\n",
    "        }\n",
    "        self.backup = None\n",
    "\n",
    "    @torch.no_grad()\n",
    "    def update(self, model: nn.Module):\n",
    "        state = model.state_dict()\n",
    "        for k, v in state.items():\n",
    "            if k not in self.shadow:\n",
    "                continue\n",
    "            self.shadow[k].mul_(self.decay)\n",
    "            self.shadow[k].add_(v.detach().cpu(), alpha=1.0 - self.decay)\n",
    "\n",
    "    def state_dict(self) -> Dict:\n",
    "        return {\n",
    "            'decay': self.decay,\n",
    "            'shadow': {k: v.clone() for k, v in self.shadow.items()},\n",
    "        }\n",
    "\n",
    "    def load_state_dict(self, state: Dict):\n",
    "        self.decay = float(state['decay'])\n",
    "        self.shadow = {k: v.clone() for k, v in state['shadow'].items()}\n",
    "        self.backup = None\n",
    "\n",
    "    def store(self, model: nn.Module):\n",
    "        self.backup = {\n",
    "            k: v.detach().cpu().clone()\n",
    "            for k, v in model.state_dict().items()\n",
    "            if v.is_floating_point()\n",
    "        }\n",
    "\n",
    "    def copy_to(self, model: nn.Module):\n",
    "        state = model.state_dict()\n",
    "        for k, v in self.shadow.items():\n",
    "            state[k] = v\n",
    "        model.load_state_dict(state, strict=True)\n",
    "\n",
    "    def restore(self, model: nn.Module):\n",
    "        if self.backup is None:\n",
    "            return\n",
    "        state = model.state_dict()\n",
    "        for k, v in self.backup.items():\n",
    "            state[k] = v\n",
    "        model.load_state_dict(state, strict=True)\n",
    "        self.backup = None\n",
    "\n",
    "\n",
    "class Trainer(ABC):\n",
    "    def __init__(self, model: nn.Module, ema_decay: Optional[float] = 0.999,\n",
    "                 ema_eval_warmup_steps: int = 0):\n",
    "        self.model = model\n",
    "        self.history: Dict[str, list] = {}\n",
    "        self.ema_decay = ema_decay\n",
    "        self.ema: Optional[ModelEMA] = None\n",
    "        self.ema_eval_warmup_steps = int(ema_eval_warmup_steps)\n",
    "        self._train_epoch = 0\n",
    "        self._train_num_epochs = 1\n",
    "        self.best_spectral_score: Optional[float] = None\n",
    "        self.best_spectral_epoch: Optional[int] = None\n",
    "        self.best_spectral_model_state_dict: Optional[Dict] = None\n",
    "        self.best_spectral_ema_state_dict: Optional[Dict] = None\n",
    "\n",
    "    @abstractmethod\n",
    "    def get_train_loss(self, **kwargs) -> torch.Tensor:\n",
    "        pass\n",
    "\n",
    "    def get_optimizer(self, lr: float, weight_decay: float = 1e-4):\n",
    "        return torch.optim.AdamW(self.model.parameters(), lr=lr, weight_decay=weight_decay)\n",
    "\n",
    "    def _record(self, key: str, value: float):\n",
    "        self.history.setdefault(key, []).append(value)\n",
    "\n",
    "    def _maybe_init_ema(self):\n",
    "        if self.ema is None and self.ema_decay is not None:\n",
    "            self.ema = ModelEMA(self.model, decay=self.ema_decay)\n",
    "\n",
    "    def ema_state_dict(self) -> Optional[Dict]:\n",
    "        if self.ema is None:\n",
    "            return None\n",
    "        return self.ema.state_dict()\n",
    "\n",
    "    def load_ema_state_dict(self, state: Optional[Dict]):\n",
    "        if state is None:\n",
    "            self.ema = None\n",
    "            return\n",
    "        decay = float(state.get('decay', self.ema_decay if self.ema_decay is not None else 0.999))\n",
    "        self.ema = ModelEMA(self.model, decay=decay)\n",
    "        self.ema.load_state_dict(state)\n",
    "\n",
    "    @staticmethod\n",
    "    def _diag_interval(epoch: int) -> int:\n",
    "        \"\"\"Scalar diagnostics: every 50 epochs until 500, then every 250.\"\"\"\n",
    "        if epoch < 500:\n",
    "            return 50\n",
    "        return 250\n",
    "\n",
    "    @staticmethod\n",
    "    def _spectral_interval(epoch: int) -> int:\n",
    "        \"\"\"Flat cadence: run the spectral diagnostic every 500 epochs.\"\"\"\n",
    "        return 500\n",
    "\n",
    "    def train(self, num_epochs: int, device: torch.device, lr: float = 1e-3,\n",
    "              run_spectral: bool = False, lr_hold_epochs: int = 0,\n",
    "              lr_eta_min_factor: float = 0.01, weight_decay: float = 1e-4,\n",
    "              **kwargs):\n",
    "        size_b = model_size_b(self.model)\n",
    "        print(f'Training model with size: {size_b / MiB:.3f} MiB')\n",
    "\n",
    "        self.model.to(device)\n",
    "        self._maybe_init_ema()\n",
    "        opt = self.get_optimizer(lr, weight_decay=weight_decay)\n",
    "        # Optional flat warmup/hold, then cosine annealing for a less aggressive LR decay.\n",
    "        hold_epochs = max(int(lr_hold_epochs), 0)\n",
    "        eta_min = max(lr * float(lr_eta_min_factor), 1e-8)\n",
    "        scheduler = torch.optim.lr_scheduler.CosineAnnealingLR(\n",
    "            opt, T_max=max(num_epochs - hold_epochs, 1), eta_min=eta_min\n",
    "        )\n",
    "        self.model.train()\n",
    "        self._train_num_epochs = max(int(num_epochs), 1)\n",
    "\n",
    "        pbar = tqdm(range(num_epochs))\n",
    "        for idx in pbar:\n",
    "            self._train_epoch = idx\n",
    "            opt.zero_grad()\n",
    "            loss = self.get_train_loss(**kwargs)\n",
    "            loss.backward()\n",
    "\n",
    "            grad_norm = torch.nn.utils.clip_grad_norm_(self.model.parameters(), max_norm=1.0)\n",
    "            opt.step()\n",
    "            if self.ema is not None:\n",
    "                self.ema.update(self.model)\n",
    "            if idx >= hold_epochs:\n",
    "                scheduler.step()\n",
    "\n",
    "            cur_lr = opt.param_groups[0]['lr']\n",
    "            self._record('train_loss', loss.item())\n",
    "            self._record('grad_norm', grad_norm.item())\n",
    "            self._record('lr', cur_lr)\n",
    "            pbar.set_description(\n",
    "                f'Epoch {idx}, loss: {loss.item():.4f}, grad: {grad_norm.item():.4f}, lr: {cur_lr:.2e}'\n",
    "            )\n",
    "\n",
    "            diag_due = (idx % self._diag_interval(idx) == 0)\n",
    "            spec_due = (\n",
    "                run_spectral and idx > 0 and hasattr(self, 'run_spectral_diagnostics')\n",
    "                and (idx % self._spectral_interval(idx) == 0)\n",
    "            )\n",
    "            if diag_due or spec_due:\n",
    "                use_ema_eval = (\n",
    "                    self.ema is not None and idx >= self.ema_eval_warmup_steps\n",
    "                )\n",
    "                if use_ema_eval:\n",
    "                    self.ema.store(self.model)\n",
    "                    self.ema.copy_to(self.model)\n",
    "                self.model.eval()\n",
    "                try:\n",
    "                    with torch.no_grad():\n",
    "                        if diag_due and hasattr(self, 'run_diagnostics'):\n",
    "                            self._record('diag_epoch', idx)\n",
    "                            self.run_diagnostics(idx, device, **kwargs)\n",
    "                        if spec_due:\n",
    "                            self.run_spectral_diagnostics(idx, device, **kwargs)\n",
    "                    if hasattr(self, '_live_plot'):\n",
    "                        self._live_plot(idx)\n",
    "                finally:\n",
    "                    if use_ema_eval:\n",
    "                        self.ema.restore(self.model)\n",
    "                    self.model.train()\n",
    "\n",
    "        self.model.eval()\n",
    "        return self.model\n",
    "\n"
   ]
