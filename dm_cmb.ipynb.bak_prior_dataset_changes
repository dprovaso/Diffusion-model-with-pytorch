    "\n",
    "\n",
    "\n",
    "def _header_to_dict(header):\n",
    "    \"\"\"Convert healpy header list-of-tuples into a dict with uppercase keys.\"\"\"\n",
    "    out = {}\n",
    "    for item in header:\n",
    "        if isinstance(item, (list, tuple)) and len(item) >= 2:\n",
    "            out[str(item[0]).upper()] = item[1]\n",
    "    return out\n",
    "\n",
    "\n",
    "def _infer_input_unit_from_header(hdict):\n",
    "    \"\"\"Best-effort unit inference from FITS header (returns 'K', 'uK', or None).\"\"\"\n",
    "    cand = []\n",
    "    for k in ('TUNIT1', 'TUNIT2', 'TUNIT3', 'BUNIT', 'UNIT'):\n",
    "        v = hdict.get(k)\n",
    "        if v is not None:\n",
    "            cand.append(str(v).strip().lower())\n",
    "\n",
    "    for s in cand:\n",
    "        s_norm = s.replace('_', '').replace(' ', '')\n",
    "        if 'uk' in s_norm or 'microk' in s_norm:\n",
    "            return 'uK'\n",
    "        if s_norm in ('k', 'kcmb') or 'kelvin' in s_norm:\n",
    "            return 'K'\n",
    "    return None\n",
    "\n",
    "\n",
    "def preprocess_pr4_hr_to_nside512(\n",
    "    hr_fits_path: str,\n",
    "    nside_out: int = 512,\n",
    "    fwhm_out_arcmin: float = 10.0,\n",
    "    fwhm_in_arcmin: float = 7.27,\n",
    "    lmax_out: int | None = None,\n",
    "    nest: bool = False,\n",
    "    verbose: bool = True,\n",
    "    input_unit: str = 'auto',\n",
    "):\n",
    "    \"\"\"\n",
    "    Read a Planck PR4/NPIPE half-ring FITS (I,Q,U), convert to uK_CMB if needed,\n",
    "    smooth to target FWHM, and downgrade to nside_out using harmonic-space processing.\n",
    "\n",
    "    Notes\n",
    "    -----\n",
    "    fwhm_in_arcmin is the assumed effective beam of the input full-sky map.\n",
    "    It is not the same quantity as the later patch_reso_arcmin=6.7 used for\n",
    "    gnomonic projections and flat-sky FFT spectra.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    input_unit : {'auto', 'K', 'uK'}\n",
    "        Unit of input FITS map. Use 'K' for Planck maps in kelvin, 'uK' if already\n",
    "        in microkelvin, or 'auto' to infer from header and fallback to RMS check.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    m_out : np.ndarray\n",
    "        Array shape (3, Npix_out) for (T,Q,U) at nside_out with target effective smoothing,\n",
    "        in uK_CMB.\n",
    "    \"\"\"\n",
    "    # Read I,Q,U + header for unit inference\n",
    "    m, hdr = hp.read_map(hr_fits_path, field=(0, 1, 2), nest=nest, h=True, verbose=False)\n",
    "    m = np.asarray(m, dtype=np.float64)\n",
    "\n",
    "    # Replace HEALPix sentinel pixels\n",
    "    for i in range(3):\n",
    "        bad = ~np.isfinite(m[i]) | (m[i] == hp.UNSEEN)\n",
    "        m[i] = np.where(bad, 0.0, m[i])\n",
    "\n",
    "    # Normalize to uK_CMB\n",
    "    hdict = _header_to_dict(hdr)\n",
    "    declared = str(input_unit).strip().lower()\n",
    "    scale_to_uK = 1.0\n",
    "    unit_note = ''\n",
    "\n",
    "    if declared in ('k', 'kelvin'):\n",
    "        scale_to_uK = 1.0e6\n",
    "        unit_note = \"input_unit='K' (explicit)\"\n",
    "    elif declared in ('uk', 'μk', 'microk', 'microkelvin'):\n",
    "        scale_to_uK = 1.0\n",
    "        unit_note = \"input_unit='uK' (explicit)\"\n",
    "    else:\n",
    "        inferred = _infer_input_unit_from_header(hdict)\n",
    "        if inferred == 'K':\n",
    "            scale_to_uK = 1.0e6\n",
    "            unit_note = 'auto-detected from FITS header as K'\n",
    "        elif inferred == 'uK':\n",
    "            scale_to_uK = 1.0\n",
    "            unit_note = 'auto-detected from FITS header as uK'\n",
    "        else:\n",
    "            t_valid = m[0][m[0] != 0]\n",
    "            st = float(np.std(t_valid)) if t_valid.size > 1000 else float(np.std(m[0]))\n",
    "            if st < 0.02:\n",
    "                scale_to_uK = 1.0e6\n",
    "                unit_note = f'auto-fallback by RMS ({st:.3e}) -> interpreted as K'\n",
    "            else:\n",
    "                scale_to_uK = 1.0\n",
    "                unit_note = f'auto-fallback by RMS ({st:.3e}) -> interpreted as uK'\n",
    "\n",
    "    m *= scale_to_uK\n",
    "    nside_in = hp.get_nside(m[0])\n",
    "\n",
    "    if lmax_out is None:\n",
    "        lmax_out = 3 * nside_out - 1\n",
    "\n",
    "    fwhm_out = np.deg2rad(fwhm_out_arcmin / 60.0)\n",
    "    fwhm_in = np.deg2rad(fwhm_in_arcmin / 60.0)\n",
    "\n",
    "    if fwhm_in > 0 and fwhm_out < fwhm_in:\n",
    "        raise ValueError('Target FWHM must be >= input FWHM for pure smoothing (no deconvolution).')\n",
    "\n",
    "    fwhm_add = np.sqrt(max(fwhm_out**2 - fwhm_in**2, 0.0))\n",
    "\n",
    "    if verbose:\n",
    "        print(f\"[preprocess] units: {unit_note}; applied scale x{scale_to_uK:g} to convert to uK_CMB\")\n",
    "        print(f\"[preprocess] nside_in={nside_in} -> nside_out={nside_out}, lmax_out={lmax_out}\")\n",
    "        print(f\"[preprocess] fwhm_in~{fwhm_in_arcmin:.3g} arcmin, fwhm_out={fwhm_out_arcmin:.3g} arcmin\")\n",
    "        print(f\"[preprocess] applying additional Gaussian smoothing fwhm_add={np.rad2deg(fwhm_add)*60:.3g} arcmin\")\n",
    "\n",
    "    lmax_in = min(3 * nside_in - 1, lmax_out)\n",
    "    almT, almE, almB = hp.map2alm(m, lmax=lmax_in, pol=True, use_pixel_weights=False, iter=3)\n",
    "\n",
    "    sigma_add = fwhm_add / np.sqrt(8.0 * np.log(2.0))\n",
    "    ell = np.arange(lmax_in + 1)\n",
    "    bl = np.exp(-0.5 * ell * (ell + 1) * sigma_add**2)\n",
    "\n",
    "    hp.almxfl(almT, bl, inplace=True)\n",
    "    hp.almxfl(almE, bl, inplace=True)\n",
    "    hp.almxfl(almB, bl, inplace=True)\n",
    "\n",
    "    m_out = hp.alm2map([almT, almE, almB], nside=nside_out, pol=True, lmax=lmax_in, verbose=False)\n",
    "    return m_out\n",
    "\n",
    "\n",
    "def y_and_d(hr1_path: str, hr2_path: str, **kwargs):\n",
    "    hr1 = preprocess_pr4_hr_to_nside512(hr1_path, **kwargs)\n",
    "    hr2 = preprocess_pr4_hr_to_nside512(hr2_path, **kwargs)\n",
    "    print('nside hrs after processing:', hp.get_nside(hr1), hp.get_nside(hr2))\n",
    "    y = 0.5 * (hr1 + hr2)\n",
    "    d = 0.5 * (hr1 - hr2)\n",
    "    return y, d\n"
   ]
