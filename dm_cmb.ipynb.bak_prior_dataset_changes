    "\n",
    "class Alpha(ABC):\n",
    "    \"\"\"\n",
    "    Abstract base class for monotone increasing signal-weight schedules.\n",
    "    Endpoints need not be exactly 0 and 1; a small floor is allowed to avoid\n",
    "    the stiff 1/alpha_t behaviour that destabilised the original sampler.\n",
    "    \"\"\"\n",
    "    def __init__(self):\n",
    "        a0 = self(torch.zeros(1, 1, 1, 1))\n",
    "        a1 = self(torch.ones(1, 1, 1, 1))\n",
    "        assert torch.all(a0 >= 0.0)\n",
    "        assert torch.all(a1 <= 1.0)\n",
    "        assert torch.all(a1 > a0)\n",
    "\n",
    "    @abstractmethod\n",
    "    def __call__(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Evaluates alpha_t. Should satisfy: self(0.0) = 0.0, self(1.0) = 1.0.\n",
    "        Args:\n",
    "            - t: time (num_samples, 1, 1, 1)\n",
    "        Returns:\n",
    "            - alpha_t (num_samples, 1, 1, 1)\n",
    "        \"\"\"\n",
    "        pass\n",
    "\n",
    "    def dt(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Evaluates d/dt alpha_t.\n",
    "        Args:\n",
    "            - t: time (num_samples, 1, 1, 1)\n",
    "        Returns:\n",
    "            - d/dt alpha_t (num_samples, 1, 1, 1)\n",
    "        \"\"\"\n",
    "\n",
    "        t = t.unsqueeze(1)  ## add a dimension necessary for vmap\n",
    "        dt = vmap(jacrev(self))(t) ## jacrev computes the Jacobian of the function and vmap applies it to each element of the tensor\n",
    "        return dt.view(-1, 1, 1, 1) ## remove the extra dimension\n",
    "\n",
    "\n",
    "\n",
    "class Beta(ABC):\n",
    "    def __init__(self):\n",
    "        b0 = self(torch.zeros(1, 1, 1, 1))\n",
    "        b1 = self(torch.ones(1, 1, 1, 1))\n",
    "        assert torch.all(b0 <= 1.0)\n",
    "        assert torch.all(b1 >= 0.0)\n",
    "        assert torch.all(b0 > b1)\n",
    "\n",
    "    @abstractmethod\n",
    "    def __call__(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Evaluates alpha_t. Should satisfy: self(0.0) = 1.0, self(1.0) = 0.0.\n",
    "        Args:\n",
    "            - t: time (num_samples, 1, 1, 1)\n",
    "        Returns:\n",
    "            - beta_t (num_samples, 1, 1, 1)\n",
    "        \"\"\"\n",
    "        pass\n",
    "\n",
    "    def dt(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Evaluates d/dt beta_t.\n",
    "        Args:\n",
    "            - t: time (num_samples, 1, 1, 1)\n",
    "        Returns:\n",
    "            - d/dt beta_t (num_samples, 1, 1, 1)\n",
    "        \"\"\"\n",
    "        t = t.unsqueeze(1)\n",
    "        dt = vmap(jacrev(self))(t)\n",
    "        return dt.view(-1, 1, 1, 1)\n",
    "\n",
    "\n",
    "\n",
    "class LinearAlpha(Alpha):\n",
    "    \"\"\"\n",
    "    We now implement a sdpecific instance of the abstract class Alpha\n",
    "    In particular, we implement alpha_t = t\n",
    "    \"\"\"\n",
    "\n",
    "    def __call__(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        return t\n",
    "\n",
    "    # def dt(self, t: torch.Tensor) -> torch.Tensor:\n",
    "    #     return torch.ones_like(t)\n",
    "\n",
    "    \"\"\"\n",
    "    When you call alpha.dt(t), Python doesn't find dt on LinearAlpha, \n",
    "    so it goes up to Alpha and uses the jacrev-based version — which will \n",
    "    automatically differentiate return t and get 1.0 for every sample.\n",
    "    \"\"\"\n",
    "    \n",
    "\n",
    "\n",
    "class LinearBeta(Beta):\n",
    "    \"\"\"\n",
    "    Implements beta_t = 1-t\n",
    "    \"\"\"\n",
    "    def __call__(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        return 1-t\n",
    "    # def dt(self, t:torch.Tensor) -> torch.Tensor:\n",
    "    #     return -torch.ones_like(t)\n",
    "\n",
    "\n",
    "class TrigonometricAlpha(Alpha):\n",
    "    \"\"\"\n",
    "    Exact variance-preserving trigonometric schedule:\n",
    "    alpha_t = sin(pi t / 2), beta_t = cos(pi t / 2), so alpha_t^2 + beta_t^2 = 1.\n",
    "    Clamp to [0, 1] only to absorb endpoint roundoff in finite precision.\n",
    "    \"\"\"\n",
    "    def __call__(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        return torch.clamp(torch.sin(0.5 * math.pi * t), min=0.0, max=1.0)\n",
    "\n",
    "\n",
    "class TrigonometricBeta(Beta):\n",
    "    def __call__(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        return torch.clamp(torch.cos(0.5 * math.pi * t), min=0.0, max=1.0)\n",
    "\n",
    "\n",
    "class BoundedTrigonometricAlpha(Alpha):\n",
    "    \"\"\"\n",
    "    Signal schedule with bounded endpoints.\n",
    "    alpha_t = sin(theta(t)), beta_t = cos(theta(t)) with\n",
    "    theta(t) affine in t and theta(0), theta(1) kept away from 0 and pi/2.\n",
    "    This avoids the exact singular endpoints of the linear path.\n",
    "    \"\"\"\n",
    "    def __init__(self, alpha_floor: float = 0.02, beta_floor: float = 0.02):\n",
    "        if not (0.0 <= alpha_floor < 1.0):\n",
    "            raise ValueError('alpha_floor must satisfy 0 <= alpha_floor < 1.')\n",
    "        if not (0.0 <= beta_floor < 1.0):\n",
    "            raise ValueError('beta_floor must satisfy 0 <= beta_floor < 1.')\n",
    "        theta_min = math.asin(alpha_floor)\n",
    "        theta_max = math.acos(beta_floor)\n",
    "        if not (theta_max > theta_min):\n",
    "            raise ValueError('Need theta_max > theta_min; reduce endpoint floors.')\n",
    "        self.alpha_floor = float(alpha_floor)\n",
    "        self.beta_floor = float(beta_floor)\n",
    "        self.theta_min = float(theta_min)\n",
    "        self.theta_max = float(theta_max)\n",
    "        super().__init__()\n",
    "\n",
    "    def _theta(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        return self.theta_min + (self.theta_max - self.theta_min) * t\n",
    "\n",
    "    def __call__(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        return torch.sin(self._theta(t))\n",
    "\n",
    "\n",
    "class BoundedTrigonometricBeta(Beta):\n",
    "    def __init__(self, alpha_floor: float = 0.02, beta_floor: float = 0.02):\n",
    "        if not (0.0 <= alpha_floor < 1.0):\n",
    "            raise ValueError('alpha_floor must satisfy 0 <= alpha_floor < 1.')\n",
    "        if not (0.0 <= beta_floor < 1.0):\n",
    "            raise ValueError('beta_floor must satisfy 0 <= beta_floor < 1.')\n",
    "        theta_min = math.asin(alpha_floor)\n",
    "        theta_max = math.acos(beta_floor)\n",
    "        if not (theta_max > theta_min):\n",
    "            raise ValueError('Need theta_max > theta_min; reduce endpoint floors.')\n",
    "        self.alpha_floor = float(alpha_floor)\n",
    "        self.beta_floor = float(beta_floor)\n",
    "        self.theta_min = float(theta_min)\n",
    "        self.theta_max = float(theta_max)\n",
    "        super().__init__()\n",
    "\n",
    "    def _theta(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        return self.theta_min + (self.theta_max - self.theta_min) * t\n",
    "\n",
    "    def __call__(self, t: torch.Tensor) -> torch.Tensor:\n",
    "        return torch.cos(self._theta(t))\n",
    "\n",
    "\n",
    "def build_default_schedule(alpha_floor: float = 0.02, beta_floor: float = 0.02) -> Tuple[Alpha, Beta]:\n",
    "    return (\n",
    "        BoundedTrigonometricAlpha(alpha_floor=alpha_floor, beta_floor=beta_floor),\n",
    "        BoundedTrigonometricBeta(alpha_floor=alpha_floor, beta_floor=beta_floor),\n",
    "    )\n",
    "\n",
    "\n",
    "def build_exact_trigonometric_schedule() -> Tuple[Alpha, Beta]:\n",
    "    return TrigonometricAlpha(), TrigonometricBeta()\n",
    "        \n",
    "\n",
    "\n",
    "class Sampleable(ABC):\n",
    "    \"\"\"\n",
    "    Distribution which can be sampled from\n",
    "    \"\"\"\n",
    "    @abstractmethod\n",
    "    def sample(self, num_samples:int) -> torch.Tensor:\n",
    "        pass\n",
    "\n",
    "\n",
    "\n",
    "class IsotropicGaussian(nn.Module, Sampleable):\n",
    "    \"\"\"\n",
    "    Sampleable wrapper around torch.randn\n",
    "    \"\"\"\n",
    "    def __init__(self, shape: List[int], std: float = 1.0):\n",
    "        \n",
    "        super().__init__()  ## inherit from nn.Module\n",
    "        self.shape = shape  ## shape = shape of sampled data\n",
    "        self.std = std\n",
    "        self.dummy = nn.Buffer(torch.zeros(1))  ## dummy parameter to make it a nn.Module\n",
    "\n",
    "    def sample(self, num_samples:int) -> torch.Tensor:\n",
    "        return self.std * torch.randn(num_samples, * self.shape).to(self.dummy.device)\n",
    "\n",
    "        \n",
    "\n",
    "class ConditionalProbabilityPath(nn.Module, ABC):\n",
    "    \"\"\"\n",
    "    Abstract base class for conditional probability paths\n",
    "    \"\"\"\n",
    "    def __init__(self, p_simple: Sampleable, p_data: Sampleable):\n",
    "        super().__init__()\n",
    "        self.p_simple = p_simple\n",
    "        self.p_data = p_data\n",
    "\n",
    "    def sample_marginal_probability(self,t: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Samples from the marginal distribution p_t(x) = p_t(x|z) p(z)\n",
    "        Args:\n",
    "            - t: time (num_samples, 1, 1, 1)\n",
    "        Returns:\n",
    "            - x: samples from p_t(x), (num_samples, c, h, w)\n",
    "        \"\"\"\n",
    "        num_samples = t.shape[0]\n",
    "        z = self.sample_conditioning_variable(num_samples)\n",
    "        x = self. sample_conditional_path(z,t)\n",
    "        return x\n",
    "\n",
    "    @abstractmethod\n",
    "    def sample_conditioning_variable(self, num_samples: int) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Samples the conditioning variable z\n",
    "        Args:\n",
    "            - num_samples: the number of samples\n",
    "        Returns:\n",
    "            - z: (num_samples, c, h, w)\n",
    "       \"\"\"\n",
    "        pass\n",
    "\n",
    "    @abstractmethod\n",
    "    def sample_conditional_path(self, z: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Samples from the conditional distribution p_t(x|z)\n",
    "        Args:\n",
    "            - z: conditioning variable (num_samples, c, h, w)\n",
    "            - t: time (num_samples, 1, 1, 1)\n",
    "        Returns:\n",
    "            - x: samples from p_t(x|z), (num_samples, c, h, w)\n",
    "        \"\"\"\n",
    "        pass\n",
    "\n",
    "    @abstractmethod\n",
    "    def conditional_vector_field(self, x: torch.Tensor, z: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Evaluates the conditional vector field u_t(x|z)\n",
    "        Args:\n",
    "            - x: position variable (num_samples, c, h, w)\n",
    "            - z: conditioning variable (num_samples, c, h, w)\n",
    "            - t: time (num_samples, 1, 1, 1)\n",
    "        Returns:\n",
    "            - conditional_vector_field: conditional vector field (num_samples, c, h, w)\n",
    "        \"\"\"\n",
    "        pass\n",
    "\n",
    "    @abstractmethod\n",
    "    def conditional_score(self, x: torch.Tensor, z: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        \"\"\"\n",
    "        Evaluates the conditional score of p_t(x|z)\n",
    "        Args:\n",
    "            - x: position variable (num_samples, c, h, w)\n",
    "            - z: conditioning variable (num_samples, c, h, w)\n",
    "            - t: time (num_samples, 1, 1, 1)\n",
    "        Returns:\n",
    "            - conditional_score: conditional score (num_samples, c, h, w)\n",
    "        \"\"\"\n",
    "        pass\n",
    "\n",
    "\n",
    "\n",
    "\n",
    "class GaussianConditionalProbabilityPath(ConditionalProbabilityPath):\n",
    "    def __init__(self, alpha: Alpha, beta: Beta, p_data: Sampleable, p_simple_shape: List[int]):\n",
    "        p_simple = IsotropicGaussian(shape = p_simple_shape, std = 1.0)\n",
    "        super().__init__(p_simple, p_data)\n",
    "        self.alpha = alpha\n",
    "        self.beta = beta\n",
    "\n",
    "    def sample_conditioning_variable(self, num_samples: int) -> torch.Tensor:\n",
    "        return self.p_data.sample(num_samples)\n",
    "\n",
    "    def sample_conditional_path(self, z: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        return self.alpha(t)*z + self.beta(t) * torch.randn_like(z)\n",
    "\n",
    "    def conditional_vector_field(self, x: torch.Tensor, z: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        alpha_t = self.alpha(t)\n",
    "        beta_t = self.beta(t)\n",
    "        dt_alpha_t = self.alpha.dt(t)\n",
    "        dt_beta_t = self.beta.dt(t)\n",
    "\n",
    "        return (dt_alpha_t - dt_beta_t / beta_t * alpha_t) * z + dt_beta_t / beta_t * x\n",
    "\n",
    "    def conditional_score(self, x: torch.Tensor, z: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        alpha_t = self.alpha(t)\n",
    "        beta_t = self.beta(t)\n",
    "        return -(x-alpha_t*z)/beta_t**2\n",
    "\n",
    "    def reconstruct_x0_from_eps(self, x: torch.Tensor, eps: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        alpha_t = self.alpha(t)\n",
    "        beta_t = self.beta(t)\n",
    "        alpha_safe = alpha_t.clamp(min=1e-6)\n",
    "        return (x - beta_t * eps) / alpha_safe\n",
    "\n",
    "    def reconstruct_x0_from_vector_field(self, x: torch.Tensor, v: torch.Tensor, t: torch.Tensor) -> torch.Tensor:\n",
    "        alpha_t = self.alpha(t)\n",
    "        beta_t = self.beta(t)\n",
    "        dt_alpha_t = self.alpha.dt(t)\n",
    "        dt_beta_t = self.beta.dt(t)\n",
    "        det = alpha_t * dt_beta_t - dt_alpha_t * beta_t\n",
    "        det_safe = torch.where(torch.abs(det) < 1e-6, torch.full_like(det, 1e-6), det)\n",
    "        return (dt_beta_t * x - beta_t * v) / det_safe\n"
   ]
