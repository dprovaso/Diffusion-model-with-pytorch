    "    \"\"\"Downgrade mask to nside_out and return candidate center pixels.\"\"\"\n",
    "    if mask_map is None:\n",
    "        npix = hp.nside2npix(nside_out)\n",
    "        return np.arange(npix, dtype=np.int64)\n",
    "\n",
    "    m = np.asarray(mask_map, dtype=float)\n",
    "    order = \"NEST\" if nest else \"RING\"\n",
    "    if hp.get_nside(m) != nside_out:\n",
    "        m = hp.ud_grade(m, nside_out, order_in=order, order_out=order)\n",
    "    m = np.clip(m, 0.0, 1.0)\n",
    "\n",
    "    idx = np.where(m >= min_mask_value)[0]\n",
    "    if idx.size == 0:\n",
    "        idx = np.where(m > 0.0)[0]\n",
    "    if idx.size == 0:\n",
    "        idx = np.arange(hp.nside2npix(nside_out), dtype=np.int64)\n",
    "    return idx\n",
    "\n",
    "\n",
    "def _project_patch_scalar(map_in, lon_deg, lat_deg, patch_size=64, patch_reso_arcmin=6.7, nest=False):\n",
    "    \"\"\"Project one scalar HEALPix map into one gnomonic patch.\n",
    "\n",
    "    patch_reso_arcmin is the flat-patch angular sampling in arcmin/pixel,\n",
    "    not the instrumental beam FWHM.\n",
    "    \"\"\"\n",
    "    nside = hp.get_nside(map_in)\n",
    "    proj = hp.projector.GnomonicProj(\n",
    "        rot=(float(lon_deg), float(lat_deg), 0.0),\n",
    "        xsize=int(patch_size),\n",
    "        ysize=int(patch_size),\n",
    "        reso=float(patch_reso_arcmin),\n",
    "    )\n",
    "\n",
    "    def vec2pix(x, y, z):\n",
    "        return hp.vec2pix(nside, x, y, z, nest=nest)\n",
    "\n",
    "    patch = proj.projmap(np.asarray(map_in, dtype=float), vec2pix)\n",
    "    patch = np.asarray(patch, dtype=np.float32)\n",
    "    patch = np.where(np.isfinite(patch), patch, 0.0)\n",
    "    return patch\n",
    "\n",
    "\n",
    "def _project_patch_tqu(tqu_map, lon_deg, lat_deg, patch_size=64, patch_reso_arcmin=6.7, nest=False, rotate_pol=True):\n",
    "    \"\"\"Project one (T,Q,U) HEALPix map into one gnomonic patch.\n",
    "\n",
    "    If rotate_pol=True, rotate (Q,U) from the native HEALPix local basis to the\n",
    "    local basis of each gnomonic pixel using a spin-2 rotation.\n",
    "\n",
    "    patch_reso_arcmin is the projected patch sampling in arcmin/pixel, not a\n",
    "    beam parameter.\n",
    "    \"\"\"\n",
    "    nside = hp.get_nside(tqu_map[0])\n",
    "    proj = hp.projector.GnomonicProj(\n",
    "        rot=(float(lon_deg), float(lat_deg), 0.0),\n",
    "        xsize=int(patch_size),\n",
    "        ysize=int(patch_size),\n",
    "        reso=float(patch_reso_arcmin),\n",
    "    )\n",
    "\n",
    "    def vec2pix(x, y, z):\n",
    "        return hp.vec2pix(nside, x, y, z, nest=nest)\n",
    "\n",
    "    t_patch = proj.projmap(np.asarray(tqu_map[0], dtype=float), vec2pix)\n",
    "    q_patch = proj.projmap(np.asarray(tqu_map[1], dtype=float), vec2pix)\n",
    "    u_patch = proj.projmap(np.asarray(tqu_map[2], dtype=float), vec2pix)\n",
    "\n",
    "    t_patch = np.asarray(t_patch, dtype=np.float32)\n",
    "    q_patch = np.asarray(q_patch, dtype=np.float32)\n",
    "    u_patch = np.asarray(u_patch, dtype=np.float32)\n",
    "\n",
    "    if rotate_pol:\n",
    "        nx = int(patch_size)\n",
    "        ny = int(patch_size)\n",
    "        reso_rad = np.deg2rad(float(patch_reso_arcmin) / 60.0)\n",
    "        x = (np.arange(nx, dtype=float) - 0.5 * (nx - 1)) * reso_rad\n",
    "        y = (np.arange(ny, dtype=float) - 0.5 * (ny - 1)) * reso_rad\n",
    "        xx, yy = np.meshgrid(x, y)\n",
    "\n",
    "        shape2d = xx.shape\n",
    "        theta, phi = proj.xy2ang(xx.ravel(), yy.ravel())\n",
    "        theta = theta.reshape(shape2d)\n",
    "        phi = phi.reshape(shape2d)\n",
    "\n",
    "        eps = 0.25 * reso_rad\n",
    "        theta_y, phi_y = proj.xy2ang(xx.ravel(), (yy + eps).ravel())\n",
    "        theta_y = theta_y.reshape(shape2d)\n",
    "        phi_y = phi_y.reshape(shape2d)\n",
    "\n",
    "        dtheta_y = theta_y - theta\n",
    "        dphi_y = (phi_y - phi + np.pi) % (2.0 * np.pi) - np.pi\n",
    "\n",
    "        east_y = np.sin(theta) * dphi_y\n",
    "        north_y = -dtheta_y\n",
    "\n",
    "        norm_y = np.hypot(east_y, north_y)\n",
    "        norm_y = np.where(norm_y > 0.0, norm_y, 1.0)\n",
    "        east_y /= norm_y\n",
    "        north_y /= norm_y\n",
    "\n",
    "        psi = np.arctan2(east_y, north_y)\n",
    "        c2 = np.cos(2.0 * psi)\n",
    "        s2 = np.sin(2.0 * psi)\n",
    "\n",
    "        q_rot = q_patch * c2 + u_patch * s2\n",
    "        u_rot = -q_patch * s2 + u_patch * c2\n",
    "        q_patch, u_patch = q_rot, u_rot\n",
    "\n",
    "    t_patch = np.where(np.isfinite(t_patch), t_patch, 0.0)\n",
    "    q_patch = np.where(np.isfinite(q_patch), q_patch, 0.0)\n",
    "    u_patch = np.where(np.isfinite(u_patch), u_patch, 0.0)\n",
    "\n",
    "    return np.stack([t_patch, q_patch, u_patch], axis=0).astype(np.float32)\n",
    "\n",
    "\n",
    "def _extract_random_patches(\n",
    "    tqu_map,\n",
    "    center_pixels,\n",
    "    num_patches,\n",
    "    rng,\n",
    "    patch_size=64,\n",
    "    patch_reso_arcmin=6.7,\n",
    "    nest=False,\n",
    "    rotate_pol=True,\n",
    "    footprint_mask=None,\n",
    "    min_patch_mask_value=0.9,\n",
    "    require_full_patch_valid=True,\n",
    "    max_attempt_factor=40,\n",
    "):\n",
    "    \"\"\"Extract random gnomonic patches from a TQU map.\n",
    "\n",
    "    If require_full_patch_valid=True and footprint_mask is provided, every pixel in\n",
    "    the projected patch must satisfy mask >= min_patch_mask_value.\n",
    "    \"\"\"\n",
    "    nside = hp.get_nside(tqu_map[0])\n",
    "    target = int(num_patches)\n",
    "    if target <= 0:\n",
    "        return np.zeros((0, 3, int(patch_size), int(patch_size)), dtype=np.float32)\n",
    "\n",
    "    patches = []\n",
    "    attempts = 0\n",
    "    max_attempts = max(target * int(max_attempt_factor), target)\n",
    "\n",
    "    while len(patches) < target and attempts < max_attempts:\n",
    "        attempts += 1\n",
    "        pix = int(rng.choice(center_pixels))\n",
    "        lon_deg, lat_deg = hp.pix2ang(nside, pix, lonlat=True, nest=nest)\n",
    "\n",
    "        if require_full_patch_valid and footprint_mask is not None:\n",
    "            m_patch = _project_patch_scalar(\n",
    "                footprint_mask,\n",
    "                lon_deg,\n",
    "                lat_deg,\n",
    "                patch_size=patch_size,\n",
    "                patch_reso_arcmin=patch_reso_arcmin,\n",
    "                nest=nest,\n",
    "            )\n",
    "            if np.any(m_patch < float(min_patch_mask_value)):\n",
    "                continue\n",
    "\n",
    "        patch = _project_patch_tqu(\n",
    "            tqu_map,\n",
    "            lon_deg,\n",
    "            lat_deg,\n",
    "            patch_size=patch_size,\n",
    "            patch_reso_arcmin=patch_reso_arcmin,\n",
    "            nest=nest,\n",
    "            rotate_pol=rotate_pol,\n",
    "        )\n",
    "        patches.append(patch)\n",
    "\n",
    "    if len(patches) < target:\n",
    "        raise RuntimeError(\n",
    "            f\"Could only extract {len(patches)} valid patches out of requested {target}. \"\n",
    "            \"Try reducing min_patch_mask_value or disabling require_full_patch_valid.\"\n",
    "        )\n",
    "\n",
    "    if attempts > 5 * target:\n",
    "        warnings.warn(\n",
    "            \"Patch extraction needed many attempts due to strict footprint filtering.\",\n",
    "            RuntimeWarning,\n",
    "        )\n",
    "\n",
    "    return np.stack(patches, axis=0).astype(np.float32)\n",
    "\n",
    "\n",
    "def _split_and_normalize(patches, train_fraction=0.9, seed=1234):\n",
    "    \"\"\"Deterministic train/val split and channel-wise normalization from train only.\"\"\"\n",
    "    rng = np.random.default_rng(seed)\n",
    "    n = patches.shape[0]\n",
    "    idx = np.arange(n)\n",
    "    rng.shuffle(idx)\n",
    "    patches = patches[idx]\n",
    "\n",
    "    n_train = max(1, int(train_fraction * n))\n",
    "    train_raw = patches[:n_train]\n",
    "    val_raw = patches[n_train:]\n",
    "\n",
    "    mean = train_raw.mean(axis=(0, 2, 3), keepdims=True)\n",
    "    std = train_raw.std(axis=(0, 2, 3), keepdims=True)\n",
    "    std = np.where(std < 1e-6, 1.0, std)\n",
    "\n",
    "    return {\n",
    "        \"train_raw\": train_raw.astype(np.float32),\n",
    "        \"val_raw\": val_raw.astype(np.float32),\n",
    "        \"train_norm\": ((train_raw - mean) / std).astype(np.float32),\n",
    "        \"val_norm\": ((val_raw - mean) / std).astype(np.float32),\n",
    "        \"mean\": mean.astype(np.float32),\n",
    "        \"std\": std.astype(np.float32),\n",
    "    }\n",
    "\n",
    "\n",
    "def _draw_one_cmb_map(\n",
    "    lensing_method,\n",
    "    seed_i,\n",
    "    *,\n",
    "    nside,\n",
    "    lmax,\n",
    "    fwhm_arcmin,\n",
    "    include_pixwin,\n",
    "    # Gaussian-from-lensed-Cl inputs\n",
    "    cl_tt_lensed=None,\n",
    "    cl_ee_lensed=None,\n",
    "    cl_bb_lensed=None,\n",
    "    cl_te_lensed=None,\n",
    "    # lenspyx-remap inputs\n",
    "    cl_tt_unl=None,\n",
    "    cl_ee_unl=None,\n",
    "    cl_bb_unl=None,\n",
    "    cl_te_unl=None,\n",
    "    cl_pp=None,\n",
    "    lenspyx_epsilon=1e-6,\n",
    "    lenspyx_nthreads=0,\n",
    "):\n",
    "    \"\"\"Single CMB map draw for the prior bank, dispatched on lensing_method.\"\"\"\n",
    "    if lensing_method == \"lenspyx_remap\":\n",
    "        if any(x is None for x in (cl_tt_unl, cl_ee_unl, cl_bb_unl, cl_te_unl, cl_pp)):\n",
    "            raise ValueError(\n",
    "                \"lensing_method='lenspyx_remap' requires unlensed Cls + cl_pp.\"\n",
    "            )\n",
    "        T_i, Q_i, U_i = simulate_lensed_cmb_tqu_lenspyx(\n",
    "            cl_tt_unl, cl_ee_unl, cl_bb_unl, cl_te_unl, cl_pp,\n",
    "            nside=nside,\n",
    "            fwhm_arcmin=fwhm_arcmin,\n",
    "            lmax=lmax,\n",
    "            include_pixwin=include_pixwin,\n",
    "            seed=seed_i,\n",
    "            lenspyx_epsilon=lenspyx_epsilon,\n",
    "            lenspyx_nthreads=lenspyx_nthreads,\n",
    "            verbose=False,\n",
    "        )\n",
    "        return T_i, Q_i, U_i\n",
    "\n",
    "    if lensing_method == \"gaussian_lensed_cl\":\n",
    "        if any(x is None for x in (cl_tt_lensed, cl_ee_lensed, cl_bb_lensed, cl_te_lensed)):\n",
    "            raise ValueError(\n",
    "                \"lensing_method='gaussian_lensed_cl' requires lensed Cls.\"\n",
    "            )\n",
    "        T_i, Q_i, U_i = simulate_cmb_tqu_from_cls(\n",
    "            cl_tt_lensed, cl_ee_lensed, cl_bb_lensed, cl_te_lensed,\n",
    "            nside=nside,\n",
    "            fwhm_arcmin=fwhm_arcmin,\n",
    "            lmax=lmax,\n",
    "            include_pixwin=include_pixwin,\n",
    "            seed=seed_i,\n",
    "        )\n",
    "        return T_i, Q_i, U_i\n",
    "\n",
    "    raise ValueError(f\"Unknown lensing_method={lensing_method!r}.\")\n",
    "\n",
    "\n",
    "def build_prior_patch_datasets(\n",
    "    # geometry\n",
    "    nside=512,\n",
    "    lmax=3 * 512 - 1,\n",
    "    fwhm_arcmin=10.0,\n",
    "    include_pixwin=True,\n",
    "    nest=False,\n",
    "    # patch config\n",
    "    patch_size=64,\n",
    "    patch_reso_arcmin=6.7,\n",
    "    patches_per_map=128,\n",
    "    min_mask_value=0.9,\n",
    "    require_full_patch_valid=True,\n",
    "    # dataset sizes\n",
    "    num_cmb_maps=64,\n",
    "    num_fg_maps=64,\n",
    "    # foreground model\n",
    "    fg_frequency_ghz=143.0,\n",
    "    fg_presets=(\"d1\", \"s1\"),\n",
    "    fg_random_rotate=True,\n",
    "    # split/save\n",
    "    train_fraction=0.9,\n",
    "    shuffle_seed=1234,\n",
    "    out_dir=\"data/priors\",\n",
    "    prefix=\"cmb_fg\",\n",
    "    # reproducibility\n",
    "    seed_cmb=0,\n",
    "    seed_fg=1,\n",
    "    # CMB lensing strategy\n",
    "    lensing_method=\"lenspyx_remap\",\n",
    "    lenspyx_epsilon=1e-6,\n",
    "    lenspyx_nthreads=0,\n",
    "):\n",
    "    \"\"\"\n",
    "    Build and save patch datasets for:\n",
    "      - prior_f (true CMB) with two interchangeable lensing strategies:\n",
    "            * 'lenspyx_remap' (default): physically correct curved-sky\n",
    "              gravitational lensing via lenspyx. Captures the lensing-induced\n",
    "              4-point function and non-Gaussian B-mode texture. Requires the\n",
    "              globals cl_TT_unl, cl_EE_unl, cl_BB_unl, cl_TE_unl, cl_PP\n",
    "              produced by generate_unlensed_cmb_cl_and_clpp.\n",
    "            * 'gaussian_lensed_cl' (legacy): Gaussian random draw with the\n",
    "              lensed CAMB Cls. Cheap but discards lensing non-Gaussianity.\n",
    "              Requires the globals cl_TT, cl_EE, cl_BB, cl_TE.\n",
    "      - prior_x (foreground from PySM).\n",
    "\n",
    "    Reuses utilities already defined in this notebook:\n",
    "      - cl_TT, cl_EE, cl_BB, cl_TE  (lensed CAMB Cls)\n",
    "      - cl_TT_unl, cl_EE_unl, cl_BB_unl, cl_TE_unl, cl_PP  (unlensed CAMB + Cl^{phi phi})\n",
    "      - simulate_cmb_tqu_from_cls / simulate_lensed_cmb_tqu_lenspyx\n",
    "      - mask (if available)\n",
    "    \"\"\"\n",
    "    out_path = Path(out_dir)\n",
    "    out_path.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "    # Center candidates and footprint mask from notebook variable `mask` if present.\n",
    "    mask_for_centers = globals().get(\"mask\", None)\n",
    "    center_pixels = _prepare_center_mask(\n",
    "        mask_for_centers,\n",
    "        nside_out=nside,\n",
    "        min_mask_value=min_mask_value,\n",
    "        nest=nest,\n",
    "    )\n",
    "\n",
    "    footprint_mask = None\n",
    "    if mask_for_centers is not None:\n",
    "        footprint_mask = np.asarray(mask_for_centers, dtype=np.float32)\n",
    "        if hp.get_nside(footprint_mask) != nside:\n",
    "            order = \"NEST\" if nest else \"RING\"\n",
    "            footprint_mask = hp.ud_grade(footprint_mask, nside, order_in=order, order_out=order)\n",
    "        footprint_mask = np.clip(footprint_mask, 0.0, 1.0)\n",
    "\n",
    "    # Pull the right CAMB spectra from the notebook globals based on lensing_method.\n",
    "    if lensing_method == \"lenspyx_remap\":\n",
    "        needed = (\"cl_TT_unl\", \"cl_EE_unl\", \"cl_BB_unl\", \"cl_TE_unl\", \"cl_PP\")\n",
    "        missing = [k for k in needed if k not in globals()]\n",
    "        if missing:\n",
    "            raise RuntimeError(\n",
    "                \"lensing_method='lenspyx_remap' requires globals \"\n",
    "                + \", \".join(needed)\n",
    "                + \" (run generate_unlensed_cmb_cl_and_clpp first). Missing: \"\n",
    "                + \", \".join(missing)\n",
    "            )\n",
    "        kw_cmb = dict(\n",
    "            cl_tt_unl=globals()[\"cl_TT_unl\"],\n",
    "            cl_ee_unl=globals()[\"cl_EE_unl\"],\n",
    "            cl_bb_unl=globals()[\"cl_BB_unl\"],\n",
    "            cl_te_unl=globals()[\"cl_TE_unl\"],\n",
    "            cl_pp=globals()[\"cl_PP\"],\n",
    "            lenspyx_epsilon=lenspyx_epsilon,\n",
    "            lenspyx_nthreads=lenspyx_nthreads,\n",
    "        )\n",
    "    elif lensing_method == \"gaussian_lensed_cl\":\n",
    "        needed = (\"cl_TT\", \"cl_EE\", \"cl_BB\", \"cl_TE\")\n",
    "        missing = [k for k in needed if k not in globals()]\n",
    "        if missing:\n",
    "            raise RuntimeError(\n",
    "                \"lensing_method='gaussian_lensed_cl' requires globals \"\n",
    "                + \", \".join(needed)\n",
    "                + \". Missing: \" + \", \".join(missing)\n",
    "            )\n",
    "        kw_cmb = dict(\n",
    "            cl_tt_lensed=globals()[\"cl_TT\"],\n",
    "            cl_ee_lensed=globals()[\"cl_EE\"],\n",
    "            cl_bb_lensed=globals()[\"cl_BB\"],\n",
    "            cl_te_lensed=globals()[\"cl_TE\"],\n",
    "        )\n",
    "    else:\n",
    "        raise ValueError(\n",
    "            f\"Unknown lensing_method={lensing_method!r}; \"\n",
    "            \"expected 'lenspyx_remap' or 'gaussian_lensed_cl'.\"\n",
    "        )\n",
    "\n",
    "    # -------------------- prior_f : lensed CMB --------------------\n",
    "    rng_cmb = np.random.default_rng(seed_cmb)\n",
    "    cmb_patch_bank = []\n",
    "    for _ in range(int(num_cmb_maps)):\n",
    "        seed_i = int(rng_cmb.integers(0, 2**31 - 1))\n",
    "        T_i, Q_i, U_i = _draw_one_cmb_map(\n",
    "            lensing_method,\n",
    "            seed_i,\n",
    "            nside=nside,\n",
    "            lmax=lmax,\n",
    "            fwhm_arcmin=fwhm_arcmin,\n",
    "            include_pixwin=include_pixwin,\n",
    "            **kw_cmb,\n",
    "        )\n",
    "        tqu_i = np.asarray([T_i, Q_i, U_i], dtype=np.float32)\n",
    "        patches_i = _extract_random_patches(\n",
    "            tqu_i,\n",
    "            center_pixels=center_pixels,\n",
    "            num_patches=patches_per_map,\n",
    "            rng=rng_cmb,\n",
    "            patch_size=patch_size,\n",
    "            patch_reso_arcmin=patch_reso_arcmin,\n",
    "            nest=nest,\n",
    "            rotate_pol=True,\n",
    "            footprint_mask=footprint_mask,\n",
    "            min_patch_mask_value=min_mask_value,\n",
    "            require_full_patch_valid=require_full_patch_valid,\n",
    "        )\n",
    "        cmb_patch_bank.append(patches_i)\n",
    "\n",
    "    cmb_patches = np.concatenate(cmb_patch_bank, axis=0)\n",
    "    cmb_split = _split_and_normalize(cmb_patches, train_fraction=train_fraction, seed=shuffle_seed)\n",
    "\n",
    "    # -------------------- prior_x : PySM foreground --------------------\n",
    "    # Build one base PySM foreground map and randomize orientation per realization.\n",
    "    sky_fg = pysm3.Sky(nside=nside, preset_strings=list(fg_presets))\n",
    "    fg_map = sky_fg.get_emission(fg_frequency_ghz * u.GHz)\n",
    "    fg_base = _to_uK_cmb(fg_map, freq_ghz=fg_frequency_ghz)\n",
    "\n",
    "    rng_fg = np.random.default_rng(seed_fg)\n",
    "    fg_patch_bank = []\n",
    "\n",
    "    for _ in range(int(num_fg_maps)):\n",
    "        fg_tqu = np.asarray(fg_base, dtype=np.float32)\n",
    "\n",
    "        if fg_random_rotate:\n",
    "            alpha = float(rng_fg.uniform(0.0, 360.0))\n",
    "            cos_beta = float(rng_fg.uniform(-1.0, 1.0))\n",
    "            beta = float(np.degrees(np.arccos(cos_beta)))\n",
    "            gamma = float(rng_fg.uniform(0.0, 360.0))\n",
    "            rot = hp.Rotator(rot=(alpha, beta, gamma), deg=True)\n",
    "            fg_tqu = np.asarray(rot.rotate_map_pixel(np.asarray(fg_tqu, dtype=np.float64)), dtype=np.float32)\n",
    "\n",
    "        # Match target beam convention used for CMB prior.\n",
    "        fg_tqu = hp.smoothing(fg_tqu, fwhm=np.deg2rad(fwhm_arcmin / 60.0), pol=True, verbose=False)\n",
    "        fg_tqu = np.asarray(fg_tqu, dtype=np.float32)\n",
    "\n",
    "        patches_i = _extract_random_patches(\n",
    "            fg_tqu,\n",
    "            center_pixels=center_pixels,\n",
    "            num_patches=patches_per_map,\n",
    "            rng=rng_fg,\n",
    "            patch_size=patch_size,\n",
