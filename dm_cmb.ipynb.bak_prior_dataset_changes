    "# CROSS-SPECTRUM CHECKS (compact)\n",
    "# NOTE: for a stable comparison with sim (which has ell=0,1=0),\n",
    "# we remove monopole/dipole from T on the masked sky and avoid very low ell.\n",
    "DELTA_ELL = 30\n",
    "ELL_MIN = 30\n",
    "\n",
    "\n",
    "# Build a spectrum mask (prefer same strict cut as map checks)\n",
    "try:\n",
