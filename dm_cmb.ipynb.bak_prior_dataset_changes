    "### Utility functions ###\n",
    "\n",
    "def enforce_ell01_zero(cl):\n",
    "    cl = np.asarray(cl, dtype=float).copy()\n",
    "    if cl.size < 2:\n",
    "        raise ValueError(\"Cl array must include at least ell=0,1 entries.\")\n",
    "    cl[:2] = 0.0\n",
    "    return cl\n",
    "\n",
    "\n",
    "def pad_or_trim_cl(cl, lmax):\n",
    "    \"\"\"\n",
    "    Ensure Cl has length lmax+1.\n",
    "    If shorter: pad with zeros. If longer: trim.\n",
    "    \"\"\"\n",
    "    cl = np.asarray(cl, dtype=float).ravel()\n",
    "    out = np.zeros(lmax + 1, dtype=float)\n",
    "    n = min(cl.size, lmax + 1)\n",
    "    out[:n] = cl[:n]\n",
    "    return out\n",
    "\n",
    "\n",
    "### Main simulation function ###\n",
    "\n",
    "def simulate_cmb_tqu_from_cls(\n",
    "    cl_tt,\n",
    "    cl_ee,\n",
    "    cl_bb,\n",
    "    cl_te,\n",
    "    nside=512,\n",
    "    fwhm_arcmin=10.0,\n",
    "    lmax=None,\n",
    "    include_pixwin=True,\n",
    "    seed=None\n",
    "):\n",
    "    \"\"\"\n",
    "    Generate Gaussian CMB T,Q,U maps from TT/EE/BB/TE C_ell.\n",
    "\n",
    "    Paper-aligned details:\n",
    "      - sets ell=0,1 to zero\n",
    "      - uses lmax <= 3*nside-1\n",
    "      - applies beam + pixel window in harmonic space\n",
    "      - preserves TE correlation via correlated synalm draw\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    cl_tt, cl_ee, cl_bb, cl_te : 1D arrays\n",
    "        C_ell arrays indexed by ell (must include ell=0,1 positions).\n",
    "        Units typically uK^2 (then maps are in uK).\n",
    "    nside : int\n",
    "        HEALPix resolution (default 512).\n",
    "    fwhm_arcmin : float\n",
    "        Gaussian beam FWHM in arcmin (default 10').\n",
    "    lmax : int or None\n",
    "        Harmonic cutoff; default min(3*nside-1, max available ell).\n",
    "    include_pixwin : bool\n",
    "        Include HEALPix pixel window P_ell.\n",
    "    seed : int or None\n",
    "        RNG seed for reproducibility.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    T, Q, U : arrays\n",
    "        HEALPix maps (RING ordering), shape (Npix,).\n",
    "    \"\"\"\n",
    "    # HEALPix recommended upper bound\n",
    "    lmax_nside = 3 * nside - 1\n",
    "\n",
    "    # infer available max ell from shortest spectrum\n",
    "    lmax_in = min(len(cl_tt), len(cl_ee), len(cl_bb), len(cl_te)) - 1\n",
    "\n",
    "    if lmax is None:\n",
    "        lmax = min(lmax_nside, lmax_in)\n",
    "    else:\n",
    "        lmax = int(lmax)\n",
    "        if lmax > lmax_nside:\n",
    "            raise ValueError(f\"lmax={lmax} > 3*nside-1={lmax_nside}\")\n",
    "        if lmax > lmax_in:\n",
    "            raise ValueError(f\"lmax={lmax} exceeds provided Cl support (max ell={lmax_in}).\")\n",
    "\n",
    "    # trim/pad and enforce ell=0,1 = 0\n",
    "    ctt = enforce_ell01_zero(pad_or_trim_cl(cl_tt, lmax))\n",
    "    cee = enforce_ell01_zero(pad_or_trim_cl(cl_ee, lmax))\n",
    "    cbb = enforce_ell01_zero(pad_or_trim_cl(cl_bb, lmax))\n",
    "    cte = enforce_ell01_zero(pad_or_trim_cl(cl_te, lmax))\n",
    "\n",
    "    # reproducibility\n",
    "    if seed is not None:\n",
    "        np.random.seed(seed)\n",
    "\n",
    "    # 1) correlated Gaussian alm draw with TT/EE/BB/TE\n",
    "    almT, almE, almB = hp.synalm([ctt, cee, cbb, cte], lmax=lmax, new=True)\n",
    "\n",
    "    # 2) build transfer functions: beam B_ell and pixel window P_ell\n",
    "    fwhm_rad = np.deg2rad(fwhm_arcmin / 60.0)\n",
    "    bl = hp.gauss_beam(fwhm=fwhm_rad, lmax=lmax)  # scalar beam\n",
    "\n",
    "    if include_pixwin:\n",
    "        # temperature and polarization pixel windows\n",
    "        pwT, pwP = hp.pixwin(nside=nside, pol=True, lmax=lmax)\n",
    "        wT = bl * pwT\n",
    "        wP = bl * pwP\n",
    "    else:\n",
    "        wT = bl\n",
    "        wP = bl\n",
    "\n",
    "    # 3) apply windows in harmonic space\n",
    "    almT = hp.almxfl(almT, wT)\n",
    "    almE = hp.almxfl(almE, wP)\n",
    "    almB = hp.almxfl(almB, wP)\n",
    "\n",
    "    # 4) alm -> T,Q,U map\n",
    "    T, Q, U = hp.alm2map([almT, almE, almB], nside=nside, lmax=lmax, pol=True, verbose=False)\n",
    "    return T, Q, U\n",
    "\n",
    "\n",
    "\n",
    "# --- Lensed-CMB simulator using lenspyx (Option 1 in the report) -----------\n",
    "\n",
    "def _plm_to_gradient_dlm(plm, lmax):\n",
    "    \"\"\"Convert lensing-potential alm to gradient-mode deflection alm.\n",
    "\n",
    "    lenspyx's alm2lenmap expects the *deflection* gradient alm\n",
    "        d_LM^grad = sqrt(L(L+1)) * phi_LM\n",
    "    (curl mode is zero for scalar lensing and can be omitted).\n",
    "    \"\"\"\n",
    "    ell = np.arange(int(lmax) + 1, dtype=float)\n",
    "    fac = np.sqrt(ell * (ell + 1.0))\n",
    "    return hp.almxfl(plm, fac, inplace=False)\n",
    "\n",
    "\n",
    "def simulate_lensed_cmb_tqu_lenspyx(\n",
    "    cl_tt_unl,\n",
    "    cl_ee_unl,\n",
    "    cl_bb_unl,\n",
    "    cl_te_unl,\n",
    "    cl_pp,\n",
    "    nside=512,\n",
    "    fwhm_arcmin=10.0,\n",
    "    lmax=None,\n",
    "    include_pixwin=True,\n",
    "    seed=None,\n",
    "    lenspyx_epsilon=1e-6,\n",
    "    lenspyx_nthreads=0,\n",
    "    verbose=False,\n",
    "    return_unlensed_alm=False,\n",
    "):\n",
    "    \"\"\"Generate gravitationally-lensed CMB (T,Q,U) maps via lenspyx remapping.\n",
    "\n",
    "    Pipeline (Option 1 of the lensing discussion in dm_cmb_notebook_report.tex):\n",
    "      1. Draw correlated unlensed (T,E,B) alms from unlensed CAMB Cls\n",
    "         (TT, EE, BB=0 for r=0, TE).\n",
    "      2. Draw the lensing potential plm independently from C_L^{phi phi}.\n",
    "      3. Convert plm to the gradient deflection alm d_LM = sqrt(L(L+1)) * phi_LM.\n",
    "      4. Use lenspyx.alm2lenmap to remap the unlensed alms onto the deflected\n",
    "         sphere. The output is a *truly lensed* (T,Q,U) realisation: lensing\n",
    "         non-Gaussianity (trispectrum, non-Gaussian B-mode texture, lensing\n",
    "         smoothing of the acoustic peaks, E -> B leakage) is reproduced\n",
    "         beyond the 2-point level.\n",
    "      5. Apply the common Gaussian beam + HEALPix pixel window to the lensed\n",
    "         maps in harmonic space, so the output shares the effective resolution\n",
    "         of the observed Planck sky y.\n",
    "\n",
    "    Note on cross-spectra. The CMB-phi cross spectra C_L^{phi T}, C_L^{phi E}\n",
    "    are *not* imposed by this routine: by drawing plm independently of the\n",
    "    unlensed (T,E,B) we capture lensing as a multiplicative non-Gaussian\n",
    "    transformation of an otherwise Gaussian primary CMB, but discard the\n",
    "    O(1e-3) ISW-lensing cross correlation. This is the standard simulation\n",
    "    convention used by Planck FFP10 / CMB-S4 sims; it is far more accurate\n",
    "    than the Gaussian-from-lensed-Cl approach implemented in\n",
    "    simulate_cmb_tqu_from_cls.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    cl_tt_unl, cl_ee_unl, cl_bb_unl, cl_te_unl : 1D arrays\n",
    "        Unlensed CMB Cls (e.g. CAMB 'unlensed_scalar') in uK^2,\n",
    "        indexed by ell with ell=0,1 included.\n",
    "    cl_pp : 1D array\n",
    "        Lensing-potential auto-spectrum C_L^{phi phi}\n",
    "        (CAMB get_lens_potential_cls(..., raw_cl=True)[:, 0]), indexed by L.\n",
    "    nside : int\n",
    "        HEALPix resolution (default 512).\n",
    "    fwhm_arcmin : float\n",
    "        Gaussian beam FWHM in arcmin (default 10').\n",
    "    lmax : int or None\n",
    "        Harmonic cutoff; default min(3*nside-1, available ell). The lensing\n",
    "        remap is done at this lmax, which must respect lmax <= 3*nside-1.\n",
    "    include_pixwin : bool\n",
    "        Multiply by HEALPix pol-aware pixel windows P_ell^{T,P}.\n",
    "    seed : int or None\n",
    "        RNG seed for reproducibility (controls both unlensed alm and phi alm).\n",
    "    lenspyx_epsilon : float\n",
    "        Target accuracy of the ducc0 non-uniform SHT inside lenspyx (default 1e-6).\n",
    "    lenspyx_nthreads : int\n",
    "        Threads for ducc0 (0 -> os.cpu_count()).\n",
    "    verbose : bool\n",
    "        If True, prints lenspyx timings.\n",
    "    return_unlensed_alm : bool\n",
    "        If True, also return the unlensed (tlm, elm, blm, plm) drawn this call.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    T, Q, U : ndarrays\n",
    "        HEALPix RING-ordered maps in the same units as the input Cl (uK).\n",
    "    (tlm, elm, blm, plm) : tuple of alm arrays, optional\n",
    "        Only returned when return_unlensed_alm=True.\n",
    "    \"\"\"\n",
    "    lmax_nside = 3 * int(nside) - 1\n",
    "    lmax_in = min(len(cl_tt_unl), len(cl_ee_unl), len(cl_bb_unl),\n",
    "                  len(cl_te_unl), len(cl_pp)) - 1\n",
    "\n",
    "    if lmax is None:\n",
    "        lmax = min(lmax_nside, lmax_in)\n",
    "    else:\n",
    "        lmax = int(lmax)\n",
    "        if lmax > lmax_nside:\n",
    "            raise ValueError(f\"lmax={lmax} > 3*nside-1={lmax_nside}\")\n",
    "        if lmax > lmax_in:\n",
    "            raise ValueError(f\"lmax={lmax} exceeds Cl support (max ell={lmax_in}).\")\n",
    "\n",
    "    # Zero unphysical ell=0,1 in all spectra (also for cl_pp, monopole/dipole of phi\n",
    "    # are gauge and not used in remapping).\n",
    "    ctt = enforce_ell01_zero(pad_or_trim_cl(cl_tt_unl, lmax))\n",
    "    cee = enforce_ell01_zero(pad_or_trim_cl(cl_ee_unl, lmax))\n",
    "    cbb = enforce_ell01_zero(pad_or_trim_cl(cl_bb_unl, lmax))\n",
    "    cte = enforce_ell01_zero(pad_or_trim_cl(cl_te_unl, lmax))\n",
    "    cpp = enforce_ell01_zero(pad_or_trim_cl(cl_pp,     lmax))\n",
    "\n",
    "    if seed is not None:\n",
    "        np.random.seed(int(seed))\n",
    "\n",
    "    # 1. Correlated unlensed (T,E,B) alm draw (TE-only, BB=0 for r=0).\n",
    "    tlm_u, elm_u, blm_u = hp.synalm([ctt, cee, cbb, cte], lmax=lmax, new=True)\n",
    "\n",
    "    # 2. Independent phi alm draw.\n",
    "    plm = hp.synalm(cpp, lmax=lmax)\n",
    "\n",
    "    # 3. Gradient-mode deflection alm.\n",
    "    dlm = _plm_to_gradient_dlm(plm, lmax=lmax)\n",
    "\n",
    "    # 4. Lenspyx remap: deflects the unlensed (T,E,B) onto the lensed sphere.\n",
    "    #    Returns shape (3, npix) for (T, Q, U) when pol=True and three alm inputs.\n",
    "    geom_info = ('healpix', {'nside': int(nside)})\n",
    "    TQU_lensed = lenspyx.alm2lenmap(\n",
    "        [tlm_u, elm_u, blm_u],\n",
    "        [dlm],                       # curl mode omitted -> zero\n",
    "        geometry=geom_info,\n",
    "        epsilon=float(lenspyx_epsilon),\n",
    "        nthreads=int(lenspyx_nthreads),\n",
    "        pol=True,\n",
    "        verbose=1 if verbose else 0,\n",
    "    )\n",
    "    TQU_lensed = np.asarray(TQU_lensed, dtype=float)\n",
    "    T_lens, Q_lens, U_lens = TQU_lensed[0], TQU_lensed[1], TQU_lensed[2]\n",
    "\n",
    "    # 5. Apply the common observational beam + pixel window AFTER lensing,\n",
    "    #    in harmonic space, matching the Planck-y processing convention.\n",
    "    fwhm_rad = np.deg2rad(float(fwhm_arcmin) / 60.0)\n",
    "    bl = hp.gauss_beam(fwhm=fwhm_rad, lmax=lmax)\n",
    "    if include_pixwin:\n",
    "        pwT, pwP = hp.pixwin(nside=int(nside), pol=True, lmax=lmax)\n",
    "        wT = bl * pwT\n",
    "        wP = bl * pwP\n",
    "    else:\n",
    "        wT = bl\n",
    "        wP = bl\n",
    "\n",
    "    almT, almE, almB = hp.map2alm(\n",
    "        [T_lens, Q_lens, U_lens], lmax=lmax, pol=True, iter=3, use_pixel_weights=False,\n",
    "    )\n",
    "    almT = hp.almxfl(almT, wT)\n",
    "    almE = hp.almxfl(almE, wP)\n",
    "    almB = hp.almxfl(almB, wP)\n",
    "\n",
    "    T, Q, U = hp.alm2map([almT, almE, almB], nside=int(nside), lmax=lmax, pol=True, verbose=False)\n",
    "\n",
    "    if return_unlensed_alm:\n",
    "        return T, Q, U, (tlm_u, elm_u, blm_u, plm)\n",
    "    return T, Q, U\n"
   ]
