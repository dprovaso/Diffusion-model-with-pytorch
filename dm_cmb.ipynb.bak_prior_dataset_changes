    "def _to_uK_cmb(arr, freq_ghz=143.0):\n",
    "    \"\"\"Convert PySM astropy Quantity to uK_CMB ndarray when possible.\"\"\"\n",
    "    try:\n",
    "        arr_uK = arr.to(u.uK_CMB, equivalencies=u.cmb_equivalencies(freq_ghz * u.GHz))\n",
    "        return np.asarray(arr_uK.value, dtype=np.float32)\n",
