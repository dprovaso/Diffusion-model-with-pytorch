    "if not np.any(use_spec):\n",
    "    use_spec = np.asarray(w > 0, dtype=bool)\n",
    "\n",
    "\n",
    "def remove_md_temperature_on_mask(t_map, mask_bool):\n",
    "    \"\"\"Remove monopole+dipole from T on masked sky and sanitize sentinels.\"\"\"\n",
    "    t_work = np.asarray(t_map, dtype=float).copy()\n",
    "    t_work[~mask_bool] = hp.UNSEEN\n",
    "    t_md = hp.remove_dipole(t_work, copy=True, fitval=False, verbose=False)\n",
    "    t_md = np.where(np.isfinite(t_md) & (t_md > hp.UNSEEN / 10.0), t_md, 0.0)\n",
    "    t_md = np.where(mask_bool, t_md, 0.0)\n",
    "    return t_md\n",
    "\n",
    "\n",
    "def apply_pol_mask(tqu, wmask):\n",
    "    tqu = np.asarray(tqu, dtype=float)\n",
    "    return np.array([tqu[0] * wmask, tqu[1] * wmask, tqu[2] * wmask])\n",
    "\n",
    "\n",
    "def anafast_pol4(m1, m2, lmax):\n",
    "    a1T, a1E, a1B = hp.map2alm(np.asarray(m1, dtype=float), lmax=lmax, pol=True, iter=3, use_pixel_weights=False)\n",
    "    a2T, a2E, a2B = hp.map2alm(np.asarray(m2, dtype=float), lmax=lmax, pol=True, iter=3, use_pixel_weights=False)\n",
    "    tt = hp.alm2cl(a1T, a2T, lmax=lmax)\n",
    "    ee = hp.alm2cl(a1E, a2E, lmax=lmax)\n",
    "    bb = hp.alm2cl(a1B, a2B, lmax=lmax)\n",
    "    te = hp.alm2cl(a1T, a2E, lmax=lmax)\n",
    "    return np.stack([tt, ee, bb, te], axis=0)\n",
    "\n",
    "\n",
    "def bin_cl(cl, lmin=ELL_MIN, lmax=LMAX_CMP, dl=DELTA_ELL):\n",
    "    ell_c, b = [], []\n",
    "    for l0 in range(lmin, lmax + 1, dl):\n",
    "        l1 = min(l0 + dl - 1, lmax)\n",
    "        sl = slice(l0, l1 + 1)\n",
    "        ell_c.append(0.5 * (l0 + l1))\n",
    "        b.append(float(np.mean(cl[sl])))\n",
    "    return np.array(ell_c), np.array(b)\n",
