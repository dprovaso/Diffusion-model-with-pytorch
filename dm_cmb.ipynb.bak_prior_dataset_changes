   "metadata": {},
   "source": [
    "##### Generate the $C_\\ell$'s with CAMB (Boltzmann solver)\n",
    "\n",
    "**What this step does**\n",
    "\n",
    "1. **`get_camb_params`** – Builds a `CAMBparams` object: flat $\\Lambda$CDM + initial power ($A_s$, $n_s$, $r$) and sets the maximum multipole `lmax` used internally by CAMB (must be $\\geq$ the `lmax` you use later for maps).\n",
    "2. **`run_camb`** – Runs the Einstein–Boltzmann solver and returns **`raw_cl=True`** spectra so each row is **$C_\\ell$** in $(\\mu\\mathrm{K})^2$, **not** $D_\\ell = \\ell(\\ell+1)C_\\ell/(2\\pi)$. Column order is **TT, EE, BB, TE** (CAMB diagonal ordering).\n",
    "3. **`get_cl_arrays`** – Cuts the `(ell_max+1, 4)` table into four 1D arrays; **`ells[i] = i`** is the physical multipole (with $\\ell=0,1$ kept so indexing matches healpy; those modes are zeroed before map synthesis).\n",
    "4. **`simulate_noisy_cl`** – Adds **cosmic-variance** scatter only for **$\\ell \\geq 2$** (monopole/dipole are not physical CMB anisotropy).\n",
    "5. **`plot_dl`** – Converts $C_\\ell \\to D_\\ell$ for display and plots **only $\\ell \\geq 2$** so the $y$-axis is not dominated by trivial zeros at $\\ell=0,1$.\n",
    "\n",
    "**Important:** Simulated maps (`synalm` + beam + pixel window) assume **µK**. Planck HR maps must be in the same unit (see preprocessing: **K → µK** auto-scale when the map RMS is tiny)."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 7,
   "id": "0ff21d1f",
   "metadata": {},
   "outputs": [],
   "source": [
    "\n",
    "def get_camb_params(H0=67.5, ombh2=0.022, omch2=0.122, mnu=0.06, omk=0.0, tau=0.06,\n",
    "                    As=2.1e-9, ns=0.965, r=0.0, lmax=1535):\n",
    "    \"\"\"Set up CAMB parameters with default Planck-like cosmology.\"\"\"\n",
    "    pars = camb.CAMBparams()\n",
    "    pars.set_cosmology(H0=H0, ombh2=ombh2, omch2=omch2, mnu=mnu, omk=omk, tau=tau)\n",
    "    pars.InitPower.set_params(As=As, ns=ns, r=r)\n",
    "    pars.set_for_lmax(lmax=lmax, lens_potential_accuracy=1)  # lens_potential_accuracy=0 for no lensing\n",
    "    return pars\n",
    "\n",
    "\n",
    "def run_camb(pars, CMB_unit='muK'):\n",
    "    \"\"\"Run CAMB and return raw C_l power spectra.\"\"\"\n",
    "    results = camb.get_results(pars)\n",
    "    # raw_cl=True returns C_l directly (not D_l = l(l+1)C_l/2pi)\n",
    "    power_spectra = results.get_cmb_power_spectra(pars, CMB_unit=CMB_unit, raw_cl=True)\n",
    "    return results, power_spectra\n",
    "\n",
    "\n",
    "def get_cl_arrays(power_spectra, spectra='total', ell_min=0):\n",
    "    \"\"\"Extract C_l arrays (TT, EE, BB, TE) from CAMB power spectra.\"\"\"\n",
    "    cl_total = power_spectra[spectra]  # shape: (ell_max+1, 4)\n",
    "    ells = np.arange(cl_total.shape[0])\n",
    "    valid = ells >= ell_min\n",
    "\n",
    "    ells = ells[valid]\n",
    "    cl_TT = cl_total[valid, 0]\n",
    "    cl_EE = cl_total[valid, 1]\n",
    "    cl_BB = cl_total[valid, 2]\n",
    "    cl_TE = cl_total[valid, 3]\n",
    "\n",
    "    return ells, cl_TT, cl_EE, cl_BB, cl_TE\n",
    "\n",
    "\n",
    "def cl_to_Dl(ells, cl):\n",
    "    \"\"\"Convert C_l to D_l = ell(ell+1) * C_l / (2 pi).\"\"\"\n",
    "    return ells * (ells + 1) * cl / (2 * np.pi)\n",
    "\n",
    "\n",
    "def simulate_noisy_cl(cl, ells, seed=None):\n",
    "    \"\"\"Simulate noisy C_l realization with Gaussian cosmic variance.\"\"\"\n",
    "    if seed is not None:\n",
    "        np.random.seed(seed)\n",
    "    var_cl = 2 * cl**2 / (2 * ells + 1)\n",
    "    return cl + np.sqrt(var_cl) * np.random.normal(size=cl.size)\n",
    "\n",
    "\n",
    "def generate_cmb_cl(H0=67.5, ombh2=0.022, omch2=0.122, mnu=0.06, omk=0.0, tau=0.06,\n",
    "                    As=2.1e-9, ns=0.965, r=0.0, lmax=1535, spectra='total'):\n",
    "    \"\"\"\n",
    "    One-stop: generate CMB C_l's for given cosmology.\n",
    "    Returns: ells, cl_TT, cl_EE, cl_BB, cl_TE\n",
    "    \"\"\"\n",
    "    pars = get_camb_params(H0=H0, ombh2=ombh2, omch2=omch2, mnu=mnu, tau=tau,\n",
    "                           As=As, ns=ns, r=r, lmax=lmax)\n",
    "    _, power_spectra = run_camb(pars)\n",
    "    return get_cl_arrays(power_spectra, spectra=spectra)\n",
    "\n",
    "\n",
    "def plot_dl(ells, cl_TT, cl_TT_noisy=None, title=None):\n",
    "    \"\"\"Plot D_l TT spectrum (optionally with noisy realization).\"\"\"\n",
    "    Dl_TT = cl_to_Dl(ells, cl_TT)\n",
    "    plt.figure(figsize=(8, 5))\n",
    "    plt.plot(ells, Dl_TT, label='Theory $D_\\\\ell^{TT}$', color='C0')\n",
    "    if cl_TT_noisy is not None:\n",
    "        Dl_TT_noisy = cl_to_Dl(ells, cl_TT_noisy)\n",
    "        plt.scatter(ells[::10], Dl_TT_noisy[::10], s=5, color='C1', \n",
    "                    label='Simulated noisy $D_\\\\ell^{TT}$')\n",
    "    plt.xlabel(r'$\\ell$')\n",
    "    plt.ylabel(r'$D_\\ell^{TT}$ [$\\mu$K$^2$]')\n",
    "    plt.legend()\n",
    "    if title:\n",
    "        plt.title(title)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n",
    "\n",
    "\n",
    "# --- Lensing-aware extension: unlensed CMB Cl + C_L^{phi phi} from CAMB ---\n",
    "\n",
    "def get_camb_results(H0=67.5, ombh2=0.022, omch2=0.122, mnu=0.06, omk=0.0, tau=0.06,\n",
    "                     As=2.1e-9, ns=0.965, r=0.0, lmax=1535,\n",
    "                     lens_potential_accuracy=1, CMB_unit='muK'):\n",
    "    \"\"\"Run CAMB once and return (pars, results, power_spectra) for downstream use.\n",
    "\n",
    "    Use this when you need both the unlensed CMB Cls and the lensing-potential\n",
    "    power spectrum C_L^{phi phi}: a single CAMB run gives access to all of them\n",
    "    via the returned `power_spectra` dict and `results` object.\n",
    "    \"\"\"\n",
    "    pars = camb.CAMBparams()\n",
    "    pars.set_cosmology(H0=H0, ombh2=ombh2, omch2=omch2, mnu=mnu, omk=omk, tau=tau)\n",
    "    pars.InitPower.set_params(As=As, ns=ns, r=r)\n",
    "    pars.set_for_lmax(lmax=lmax, lens_potential_accuracy=int(lens_potential_accuracy))\n",
    "    results = camb.get_results(pars)\n",
    "    power_spectra = results.get_cmb_power_spectra(pars, CMB_unit=CMB_unit, raw_cl=True)\n",
    "    return pars, results, power_spectra\n",
    "\n",
    "\n",
    "def generate_unlensed_cmb_cl_and_clpp(\n",
    "    H0=67.5, ombh2=0.022, omch2=0.122, mnu=0.06, omk=0.0, tau=0.06,\n",
    "    As=2.1e-9, ns=0.965, r=0.0, lmax=1535, lens_potential_accuracy=1,\n",
    "):\n",
    "    \"\"\"Compute unlensed CMB Cls + lensing-potential C_L^{phi phi} for lenspyx remapping.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    ells : (lmax+1,) int array\n",
    "    cl_TT_u, cl_EE_u, cl_BB_u, cl_TE_u : 1D arrays, *unlensed_scalar* spectra in uK^2\n",
    "    cl_pp : 1D array, lensing-potential auto-spectrum C_L^{phi phi} (dimensionless)\n",
    "\n",
    "    Notes\n",
    "    -----\n",
    "    * `unlensed_scalar` is the right CAMB key when lensing is applied via remapping:\n",
    "      using the *lensed_scalar* or `total` (=lensed) spectra here would double-count\n",
    "      lensing. With r=0 the unlensed BB is identically zero.\n",
    "    * `get_lens_potential_cls(raw_cl=True)` returns C_L^{phi phi} directly\n",
    "      (column 0), not L^4 C_L^{phi phi}/(2 pi).\n",
    "    \"\"\"\n",
    "    pars, results, power_spectra = get_camb_results(\n",
    "        H0=H0, ombh2=ombh2, omch2=omch2, mnu=mnu, omk=omk, tau=tau,\n",
    "        As=As, ns=ns, r=r, lmax=lmax,\n",
    "        lens_potential_accuracy=lens_potential_accuracy,\n",
    "    )\n",
    "\n",
    "    cl_unl = power_spectra['unlensed_scalar']  # CAMB may return > lmax+1 rows\n",
    "    cl_phi = results.get_lens_potential_cls(lmax=lmax, raw_cl=True)  # exactly lmax+1 rows\n",
    "\n",
    "    # Trim everything to lmax+1 so all returned arrays are the same length.\n",
    "    # CAMB's get_cmb_power_spectra can return a few extra multipoles beyond the\n",
    "    # requested lmax (internal buffer), while get_lens_potential_cls honours lmax\n",
    "    # exactly. Without trimming, ells would be longer than cl_pp and cause a\n",
    "    # broadcast error.\n",
    "    n = lmax + 1\n",
    "    cl_unl = cl_unl[:n]\n",
    "    cl_phi = cl_phi[:n]\n",
    "\n",
    "    ells = np.arange(n)\n",
    "    cl_TT_u = cl_unl[:, 0]\n",
    "    cl_EE_u = cl_unl[:, 1]\n",
    "    cl_BB_u = cl_unl[:, 2]   # identically zero for r=0\n",
    "    cl_TE_u = cl_unl[:, 3]\n",
    "    cl_pp = cl_phi[:, 0]\n",
    "\n",
    "    return ells, cl_TT_u, cl_EE_u, cl_BB_u, cl_TE_u, cl_pp\n",
    "\n",
    "\n",
    "def plot_clpp(ells, cl_pp, title=r'$L^4 C_L^{\\phi\\phi}/(2\\pi)$'):\n",
    "    \"\"\"Display the lensing-potential power spectrum in the standard L^4 C / (2pi) units.\"\"\"\n",
    "    plt.figure(figsize=(8, 5))\n",
    "    Ls = np.maximum(ells, 1)\n",
    "    plt.loglog(ells[2:], Ls[2:]**4 * cl_pp[2:] / (2*np.pi))\n",
    "    plt.xlabel(r'$L$')\n",
    "    plt.ylabel(title)\n",
    "    plt.grid(True, which='both', alpha=0.3)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
