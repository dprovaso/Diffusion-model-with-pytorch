    "class ScoreSDE(SDE):\n",
    "    \"\"\"\n",
    "    Converts a trained noise predictor into an SDE for sampling.\n",
    "    Uses the conversion formula (Proposition 1, flow-matching.pdf):\n",
    "        u_t(x) = (beta_t^2 * dt_alpha/alpha_t - dt_beta * beta_t) * s_t(x) + (dt_alpha/alpha_t) * x\n",
    "    Combined with the SDE extension (Theorem 13):\n",
    "        drift = u_t(x) + (sigma^2 / 2) * s_t(x)\n",
    "    where s_t(x) = -eps_t(x) / beta_t.\n",
    "    \"\"\"\n",
    "    def __init__(self, eps_net: NoisePredictor, alpha: Alpha, beta: Beta, sigma: float = 0.1):\n",
    "        self.eps_net = eps_net\n",
    "        self.alpha = alpha\n",
    "        self.beta = beta\n",
    "        self.sigma = sigma\n",
    "\n",
    "    def drift_coefficient(self, x: torch.Tensor, t: torch.Tensor, **kwargs) -> torch.Tensor:\n",
    "        alpha_t = self.alpha(t)\n",
    "        beta_t = self.beta(t)\n",
    "        dt_alpha = self.alpha.dt(t)\n",
    "        dt_beta = self.beta.dt(t)\n",
    "\n",
